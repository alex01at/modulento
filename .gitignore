/vendor/
/var/cache/twig/*
!/var/cache/twig/.gitkeep
/var/log/*
!/var/log/.gitkeep
/var/uploads/
/var/updates/
# The key API keys of payment services are encrypted with; never leaves the server.
/var/secret.key
/VERSION
.env
.DS_Store
.vscode/sftp.json
/dist/
# Clones or symlinks of the extensions' own repositories (modulento-ext-freelancer,
# modulento-ext-auction): the tests need both. No trailing slash, so that a
# symlink is ignored as well.
/extensions/freelancer
/extensions/auction
