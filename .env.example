# dev shows errors and disables the Twig cache; anything else is production
APP_ENV="prod"
APP_URL="http://127.0.0.1:8098"
APP_NAME="Modulento"
# Secret for the cron URL /cron/<token>; empty switches that URL off
CRON_TOKEN=""

DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASS=""

# GitHub repository whose releases the administration installs; empty
# switches updates off. UPDATE_TOKEN is only needed while that repository
# is private: a fine-grained token with read-only "Contents" access.
UPDATE_REPO="alex01at/modulento"
UPDATE_TOKEN=""

# Base address of the license server behind Administration -> Shop (browse
# and buy official products straight from here) and behind a package
# installed as "license:<product>" (Administration -> Extensions and
# themes). Also used, for a plain GitHub repository, as an optional
# speedup/fallback the server itself opts certain products into - never a
# requirement, a plain repo it does not know about is unaffected. Empty:
# the Shop is empty and no "license:" package can ever be installed here.
LICENSE_SERVER_URL="https://server.modulento.com"

# Sender address of e-mails; empty means noreply@<host of APP_URL>
MAIL_FROM=""

# Repositories extensions and themes may be installed from in the
# administration, comma-separated, "*" allowed: "owner/*, other/name".
# Without this line: every repository of the owner of UPDATE_REPO.
# PACKAGE_SOURCES="alex01at/*"

# Only behind a reverse proxy or CDN: its addresses or networks,
# comma-separated ("10.0.0.0/8, 2001:db8::/32"). Requests from these may
# name the visitor in X-Forwarded-For; without it, all visitors would share
# one limit for logins and registrations. Leave empty otherwise.
# TRUSTED_PROXIES=""
