# dev shows errors and disables the Twig cache; anything else is production
APP_ENV="prod"
APP_URL="http://127.0.0.1:8098"
APP_NAME="Modulento"
# Folder name below themes/, empty for the built-in templates
APP_THEME=""

DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASS=""

# GitHub repository whose releases the administration installs; empty
# switches updates off. UPDATE_TOKEN is only needed while that repository
# is private: a fine-grained token with read-only "Contents" access.
UPDATE_REPO="alex01at/modulento"
UPDATE_TOKEN=""
