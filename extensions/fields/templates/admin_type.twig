{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('fields.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {
    heading: type ? trans('fields.type.edit') : trans('fields.type.new'),
    crumbs: [{label: trans('fields.title'), path: '/admin/fields'}]
} only %}

{% for error in errors %}
    <p class="flash flash-error" role="alert">{{ error }}</p>
{% endfor %}

<form method="post" action="{{ url(type ? '/admin/fields/' ~ type.id : '/admin/fields/new') }}">
    {{ csrf_field() }}
    <div class="columns">
        {% for code in locales %}
            <fieldset class="card-box">
                <legend>{{ locale_name(code) }}</legend>
                <div class="field">
                    <label for="label_{{ code }}">{{ trans('fields.type.name') }}</label>
                    <input id="label_{{ code }}" name="label[{{ code }}]" value="{{ labels[code] ?? '' }}" maxlength="100" lang="{{ code }}" {{ code == default ? 'required' }}>
                </div>
            </fieldset>
        {% endfor %}
    </div>
    <div class="card-box stack-form wide">
        <div class="field">
            <label for="position">{{ trans('fields.field.position') }}</label>
            <input id="position" name="position" type="number" value="{{ position }}">
        </div>
        <button type="submit">{{ trans('core.account.save') }}</button>
    </div>
</form>

{% if type %}
    <section class="card-box">
        <h2>{{ trans('fields.type.fields') }}</h2>
        {% if type.fields is empty %}
            <p>{{ trans('fields.field.none') }}</p>
        {% else %}
            <table>
                <thead>
                <tr>
                    <th scope="col">{{ trans('fields.field.label') }}</th>
                    <th scope="col">{{ trans('fields.field.kind') }}</th>
                    <th scope="col">{{ trans('fields.field.flags') }}</th>
                </tr>
                </thead>
                <tbody>
                {% for field in type.fields %}
                    <tr>
                        <td><a href="{{ url('/admin/fields/' ~ type.id ~ '/field/' ~ field.id) }}">{{ field.label }}</a></td>
                        <td>{{ trans('fields.kind.' ~ field.kind) }}</td>
                        <td>
                            {{ field.required ? trans('fields.field.required') ~ ' · ' }}
                            {{ field.filterable ? trans('fields.field.filterable') ~ ' · ' }}
                            {{ field.sortable ? trans('fields.field.sortable') ~ ' · ' }}
                            {{ field.in_card ? trans('fields.field.in_card') ~ ' · ' }}
                            {{ field.is_price ? trans('fields.field.is_price') }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
        {% if type.fields|length < max_fields %}
            <p><a class="button" href="{{ url('/admin/fields/' ~ type.id ~ '/field/new') }}">{{ trans('fields.field.new') }}</a></p>
        {% endif %}
    </section>

    <section class="card-box">
        <form method="post" action="{{ url('/admin/fields/' ~ type.id ~ '/delete') }}" class="danger-form">
            {{ csrf_field() }}
            <p><small>{{ trans(type.offers > 0 ? 'fields.type.delete_blocked' : 'fields.type.delete_hint', {count: type.offers}) }}</small></p>
            <button type="submit" class="danger" {{ type.offers > 0 ? 'disabled' }}>{{ trans('fields.type.delete') }}</button>
        </form>
    </section>
{% endif %}
{% endblock %}
