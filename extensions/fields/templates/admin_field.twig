{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('fields.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {
    heading: field_id ? trans('fields.field.edit') : trans('fields.field.new'),
    crumbs: [{label: trans('fields.title'), path: '/admin/fields'}, {label: trans('fields.type.fields'), path: '/admin/fields/' ~ type_id}]
} only %}

{% for error in errors %}
    <p class="flash flash-error" role="alert">{{ error }}</p>
{% endfor %}

<form method="post" action="{{ url('/admin/fields/' ~ type_id ~ '/field/' ~ (field_id ?: 'new')) }}">
    {{ csrf_field() }}
    <div class="columns">
        {% for code in locales %}
            <fieldset class="card-box">
                <legend>{{ locale_name(code) }}</legend>
                <div class="field">
                    <label for="label_{{ code }}">{{ trans('fields.field.label') }}</label>
                    <input id="label_{{ code }}" name="label[{{ code }}]" value="{{ form.labels[code] ?? '' }}" maxlength="100" lang="{{ code }}" {{ code == default ? 'required' }}>
                </div>
            </fieldset>
        {% endfor %}
    </div>

    <div class="card-box stack-form wide">
        <div class="field">
            <label for="kind">{{ trans('fields.field.kind') }}</label>
            {% if field_id %}
                <input id="kind" value="{{ trans('fields.kind.' ~ form.kind) }}" disabled>
                <small>{{ trans('fields.field.kind_fixed') }}</small>
            {% else %}
                <select id="kind" name="kind">
                    {% for kind in kinds %}
                        <option value="{{ kind }}" {{ kind == form.kind ? 'selected' }}>{{ trans('fields.kind.' ~ kind) }}</option>
                    {% endfor %}
                </select>
            {% endif %}
        </div>
        <div class="field">
            <label><input type="checkbox" name="required" value="1" {{ form.required ?? false ? 'checked' }}> {{ trans('fields.field.required') }}</label>
            <label><input type="checkbox" name="in_card" value="1" {{ form.in_card ?? false ? 'checked' }}> {{ trans('fields.field.in_card') }}</label>
            <label><input type="checkbox" name="filterable" value="1" {{ form.filterable ?? false ? 'checked' }}> {{ trans('fields.field.filterable') }}</label>
            <small>{{ trans('fields.field.filterable_hint') }}</small>
            <label><input type="checkbox" name="sortable" value="1" {{ form.sortable ?? false ? 'checked' }}> {{ trans('fields.field.sortable') }}</label>
            <small>{{ trans('fields.field.sortable_hint') }}</small>
            <label><input type="checkbox" name="is_price" value="1" {{ form.is_price ?? false ? 'checked' }}> {{ trans('fields.field.is_price') }}</label>
            <small>{{ trans('fields.field.is_price_hint') }}</small>
        </div>
        <div class="field">
            <label for="position">{{ trans('fields.field.position') }}</label>
            <input id="position" name="position" type="number" value="{{ form.position ?? 0 }}">
        </div>
    </div>

    {% if form.kind == 'select' or not field_id %}
        <fieldset class="card-box">
            <legend>{{ trans('fields.field.options') }}</legend>
            <p><small>{{ trans('fields.field.options_hint') }}</small></p>
            {% for option in form.options %}
                <div class="field-grid">
                    <input type="hidden" name="options[{{ loop.index0 }}][value]" value="{{ option.value }}">
                    {% for code in locales %}
                        <div class="field">
                            <label class="visually-hidden" for="opt_{{ loop.parent.loop.index0 }}_{{ code }}">{{ locale_name(code) }}</label>
                            <input id="opt_{{ loop.parent.loop.index0 }}_{{ code }}" name="options[{{ loop.parent.loop.index0 }}][label][{{ code }}]" value="{{ option.labels[code] ?? '' }}" maxlength="100" lang="{{ code }}" placeholder="{{ locale_name(code) }}">
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        </fieldset>
    {% endif %}

    <p><button type="submit">{{ trans('core.account.save') }}</button></p>
</form>

{% if field_id %}
    <section class="card-box">
        <form method="post" action="{{ url('/admin/fields/' ~ type_id ~ '/field/' ~ field_id ~ '/delete') }}" class="danger-form">
            {{ csrf_field() }}
            <p><small>{{ trans('fields.field.delete_hint') }}</small></p>
            <button type="submit" class="danger">{{ trans('fields.field.delete') }}</button>
        </form>
    </section>
{% endif %}
{% endblock %}
