{# The fields of a custom type inside the offer form and the wizard. Receives "type_data". #}
{% set codes = selected is defined ? selected : locales %}
{% for field in type_data.fields %}
    {% set id = 'cf_' ~ field.key %}
    {% set hint = field.error ? id ~ '_error' : null %}
    <div class="field">
        {% if field.kind == 'text' or field.kind == 'textarea' %}
            {% for code in codes %}
                <label for="{{ id }}_{{ code }}">{{ field.label }}{{ codes|length > 1 ? ' (' ~ locale_name(code) ~ ')' }}{{ field.required and loop.first ? ' *' }}</label>
                {% if field.kind == 'text' %}
                    <input id="{{ id }}_{{ code }}" name="cf[{{ field.key }}][{{ code }}]" value="{{ field.value[code] ?? '' }}" maxlength="255" lang="{{ code }}"{% if hint %} aria-invalid="true" aria-describedby="{{ hint }}"{% endif %}>
                {% else %}
                    <textarea id="{{ id }}_{{ code }}" name="cf[{{ field.key }}][{{ code }}]" rows="5" maxlength="5000" lang="{{ code }}"{% if hint %} aria-invalid="true" aria-describedby="{{ hint }}"{% endif %}>{{ field.value[code] ?? '' }}</textarea>
                {% endif %}
            {% endfor %}
        {% elseif field.kind == 'number' %}
            <label for="{{ id }}">{{ field.label }}{{ field.required ? ' *' }}</label>
            <input id="{{ id }}" name="cf[{{ field.key }}]" value="{{ field.value }}" inputmode="decimal" maxlength="16"{% if hint %} aria-invalid="true" aria-describedby="{{ hint }}"{% endif %}>
        {% elseif field.kind == 'date' %}
            <label for="{{ id }}">{{ field.label }}{{ field.required ? ' *' }}</label>
            <input id="{{ id }}" name="cf[{{ field.key }}]" type="date" value="{{ field.value }}"{% if hint %} aria-invalid="true" aria-describedby="{{ hint }}"{% endif %}>
        {% elseif field.kind == 'select' %}
            <label for="{{ id }}">{{ field.label }}{{ field.required ? ' *' }}</label>
            <select id="{{ id }}" name="cf[{{ field.key }}]"{% if hint %} aria-invalid="true" aria-describedby="{{ hint }}"{% endif %}>
                <option value=""></option>
                {% for option in field.options %}
                    <option value="{{ option.value }}" {{ option.value == field.value ? 'selected' }}>{{ option.label }}</option>
                {% endfor %}
            </select>
        {% elseif field.kind == 'checkbox' %}
            <label for="{{ id }}">
                <input id="{{ id }}" name="cf[{{ field.key }}]" type="checkbox" value="1" {{ field.value == '1' ? 'checked' }}{% if hint %} aria-invalid="true" aria-describedby="{{ hint }}"{% endif %}>
                {{ field.label }}{{ field.required ? ' *' }}
            </label>
        {% endif %}
        {% if field.error %}<small id="{{ hint }}" class="field-error" role="alert">{{ trans(field.error) }}</small>{% endif %}
    </div>
{% endfor %}
