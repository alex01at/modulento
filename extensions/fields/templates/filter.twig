{# The filters of a custom type, inside the list's search form. Receives "filter". #}
{% for field in filter.fields %}
    {% set id = 'f_' ~ field.key %}
    {% if field.kind == 'select' %}
        <label class="visually-hidden" for="{{ id }}">{{ field.label }}</label>
        <select id="{{ id }}" name="f[{{ field.key }}]">
            <option value="">{{ field.label }}: {{ trans('fields.filter.any') }}</option>
            {% for option in field.options %}
                <option value="{{ option.value }}" {{ (filter.values[field.key] ?? '') == option.value ? 'selected' }}>{{ option.label }}</option>
            {% endfor %}
        </select>
    {% elseif field.kind == 'checkbox' %}
        <label for="{{ id }}"><input id="{{ id }}" type="checkbox" name="f[{{ field.key }}]" value="1" {{ (filter.values[field.key] ?? '') == '1' ? 'checked' }}> {{ field.label }}</label>
    {% elseif field.kind == 'text' %}
        <label class="visually-hidden" for="{{ id }}">{{ field.label }}</label>
        <input id="{{ id }}" type="search" name="f[{{ field.key }}]" value="{{ filter.values[field.key] ?? '' }}" placeholder="{{ field.label }}" maxlength="100">
    {% elseif field.kind == 'number' %}
        <span class="filter-range">
            <span>{{ field.label }}</span>
            <label class="visually-hidden" for="{{ id }}_min">{{ field.label }} {{ trans('fields.filter.min') }}</label>
            <input id="{{ id }}_min" name="f[{{ field.key }}_min]" value="{{ filter.values[field.key ~ '_min'] ?? '' }}" inputmode="decimal" size="8" placeholder="{{ trans('fields.filter.min') }}">
            <label class="visually-hidden" for="{{ id }}_max">{{ field.label }} {{ trans('fields.filter.max') }}</label>
            <input id="{{ id }}_max" name="f[{{ field.key }}_max]" value="{{ filter.values[field.key ~ '_max'] ?? '' }}" inputmode="decimal" size="8" placeholder="{{ trans('fields.filter.max') }}">
        </span>
    {% elseif field.kind == 'date' %}
        <span class="filter-range">
            <span>{{ field.label }}</span>
            <label class="visually-hidden" for="{{ id }}_from">{{ field.label }} {{ trans('fields.filter.from') }}</label>
            <input id="{{ id }}_from" type="date" name="f[{{ field.key }}_from]" value="{{ filter.values[field.key ~ '_from'] ?? '' }}">
            <label for="{{ id }}_to">{{ trans('fields.filter.to') }}</label>
            <input id="{{ id }}_to" type="date" name="f[{{ field.key }}_to]" value="{{ filter.values[field.key ~ '_to'] ?? '' }}">
        </span>
    {% endif %}
{% endfor %}
