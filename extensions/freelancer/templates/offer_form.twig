{# Included inside the core's offer form. Receives type_data and currency. #}
{% for tier in type_data.tiers %}
    {% set package = type_data.packages[tier] %}
    <fieldset>
        <legend>{{ trans('freelancer.form.package', {name: trans('freelancer.tier.' ~ tier)}) }}</legend>
        {% if tier > 1 %}
            <p><small>{{ trans('freelancer.form.package_optional') }}</small></p>
        {% endif %}

        <label for="package_{{ tier }}_price">{{ trans('freelancer.form.price', {currency: currency}) }}</label>
        <input id="package_{{ tier }}_price" name="package[{{ tier }}][price]" value="{{ package.price ?? '' }}" inputmode="decimal" {{ tier == 1 ? 'required' }}>

        <label for="package_{{ tier }}_days">{{ trans('freelancer.form.delivery_days') }}</label>
        <input id="package_{{ tier }}_days" name="package[{{ tier }}][delivery_days]" type="number" min="1" max="365" value="{{ package.delivery_days ?? '' }}" {{ tier == 1 ? 'required' }}>

        <label for="package_{{ tier }}_revisions">{{ trans('freelancer.form.revisions') }}</label>
        <input id="package_{{ tier }}_revisions" name="package[{{ tier }}][revisions]" type="number" min="0" max="99" value="{{ package.revisions ?? 0 }}">

        {% for code in type_data.locales %}
            {% set text = package.text[code] ?? {} %}
            <label for="package_{{ tier }}_name_{{ code }}">{{ trans('freelancer.form.package_name') }} ({{ locale_name(code) }})</label>
            <input id="package_{{ tier }}_name_{{ code }}" name="package[{{ tier }}][text][{{ code }}][name]" value="{{ text.name ?? '' }}" maxlength="80" lang="{{ code }}" placeholder="{{ trans('freelancer.tier.' ~ tier) }}">

            <label for="package_{{ tier }}_description_{{ code }}">{{ trans('freelancer.form.package_description') }} ({{ locale_name(code) }})</label>
            <textarea id="package_{{ tier }}_description_{{ code }}" name="package[{{ tier }}][text][{{ code }}][description]" rows="3" maxlength="1000" lang="{{ code }}">{{ text.description ?? '' }}</textarea>
        {% endfor %}
    </fieldset>
{% endfor %}

<fieldset>
    <legend>{{ trans('freelancer.form.extras') }}</legend>
    <p><small>{{ trans('freelancer.form.extras_hint') }}</small></p>
    {% for index, extra in type_data.extras %}
        {% for code in type_data.locales %}
            <label for="extra_{{ index }}_title_{{ code }}">{{ trans('freelancer.form.extra_title', {number: index + 1}) }} ({{ locale_name(code) }})</label>
            <input id="extra_{{ index }}_title_{{ code }}" name="extra[{{ index }}][text][{{ code }}][title]" value="{{ extra.text[code].title ?? '' }}" maxlength="150" lang="{{ code }}">
        {% endfor %}
        <label for="extra_{{ index }}_price">{{ trans('freelancer.form.price', {currency: currency}) }}</label>
        <input id="extra_{{ index }}_price" name="extra[{{ index }}][price]" value="{{ extra.price ?? '' }}" inputmode="decimal">
        <label for="extra_{{ index }}_days">{{ trans('freelancer.form.extra_days') }}</label>
        <input id="extra_{{ index }}_days" name="extra[{{ index }}][extra_days]" type="number" min="0" max="365" value="{{ extra.extra_days ?? 0 }}">
    {% endfor %}
</fieldset>

<fieldset>
    <legend>{{ trans('freelancer.form.requirements') }}</legend>
    <p><small>{{ trans('freelancer.form.requirements_hint') }}</small></p>
    {% for code in type_data.locales %}
        <label for="requirements_{{ code }}">{{ locale_name(code) }}</label>
        <textarea id="requirements_{{ code }}" name="requirements[{{ code }}]" rows="4" maxlength="2000" lang="{{ code }}">{{ type_data.requirements[code] ?? '' }}</textarea>
    {% endfor %}
</fieldset>
