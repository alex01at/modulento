{# Included in the core's order form. Receives flow_data. #}
<fieldset>
    <legend>{{ trans('freelancer.detail.packages') }}</legend>
    {% for package in flow_data.packages %}
        <label class="checkbox">
            <input type="radio" name="package" value="{{ package.tier }}" {{ package.tier == flow_data.selected_package ? 'checked' }} required>
            <span>
                <strong>{{ package.name }}</strong> – {{ money(package.price, flow_data.currency) }}<br>
                <small>
                    {{ trans(package.delivery_days == 1 ? 'freelancer.detail.delivery_day' : 'freelancer.detail.delivery_days', {days: package.delivery_days}) }}
                    · {{ trans(package.revisions == 1 ? 'freelancer.detail.revision' : 'freelancer.detail.revisions', {count: package.revisions}) }}
                </small>
                {% if package.description %}<br>{{ package.description|nl2br }}{% endif %}
            </span>
        </label>
    {% endfor %}
</fieldset>

{% if flow_data.extras %}
    <fieldset>
        <legend>{{ trans('freelancer.detail.extras') }}</legend>
        {% for index, extra in flow_data.extras %}
            <label class="checkbox">
                <input type="checkbox" name="extras[]" value="{{ index }}" {{ index in flow_data.selected_extras ? 'checked' }}>
                <span>
                    {{ extra.title }} – + {{ money(extra.price, flow_data.currency) }}
                    {% if extra.extra_days > 0 %}
                        ({{ trans(extra.extra_days == 1 ? 'freelancer.detail.extra_day' : 'freelancer.detail.extra_days', {days: extra.extra_days}) }})
                    {% endif %}
                </span>
            </label>
        {% endfor %}
    </fieldset>
{% endif %}

{% if flow_data.requirements %}
    <p><strong>{{ trans('freelancer.detail.requirements') }}</strong><br>{{ flow_data.requirements|nl2br }}</p>
{% endif %}
