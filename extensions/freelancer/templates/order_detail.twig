{# Included on the order page. Receives flow_data. #}
<ul>
    <li>
        {{ trans(flow_data.delivery_days == 1 ? 'freelancer.detail.delivery_day' : 'freelancer.detail.delivery_days', {days: flow_data.delivery_days}) }}
        {% if flow_data.deliver_by %}
            – {{ trans('freelancer.order.deliver_by', {date: flow_data.deliver_by}) }}
            {% if flow_data.overdue %}<strong>{{ trans('freelancer.order.overdue') }}</strong>{% endif %}
        {% endif %}
    </li>
    <li>{{ trans('freelancer.order.revisions', {used: flow_data.revisions_used, total: flow_data.revisions}) }}</li>
</ul>
