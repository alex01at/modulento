{# Included inside the core's offer form. Receives type_data and currency. #}
<fieldset>
    <legend>{{ trans('auction.form.title') }}</legend>

    {% if type_data.locked %}
        {# Bidders rely on these terms: shown, not editable. #}
        <p class="flash">{{ trans(type_data.status == 'sold' ? 'auction.form.locked_sold' : 'auction.form.locked_open', {date: type_data.ends_at}) }}</p>
        <ul>
            <li>{{ trans('auction.form.start_price', {currency: currency}) }}: {{ type_data.start_price }}</li>
            <li>{{ trans('auction.form.step', {currency: currency}) }}: {{ type_data.step }}</li>
            <li>{{ trans('auction.form.duration') }}: {{ trans(type_data.duration_days == 1 ? 'auction.form.day' : 'auction.form.days', {days: type_data.duration_days}) }}</li>
        </ul>
    {% else %}
        {% if type_data.status in ['unsold', 'cancelled'] %}
            <p class="flash">{{ trans('auction.form.relist') }}</p>
        {% endif %}

        <label for="start_price">{{ trans('auction.form.start_price', {currency: currency}) }}</label>
        <input id="start_price" name="start_price" value="{{ type_data.start_price }}" inputmode="decimal" required>

        <label for="step">{{ trans('auction.form.step', {currency: currency}) }}</label>
        <input id="step" name="step" value="{{ type_data.step }}" inputmode="decimal">
        <small>{{ trans('auction.form.step_hint') }}</small>

        <label for="duration_days">{{ trans('auction.form.duration') }}</label>
        <select id="duration_days" name="duration_days">
            {% for days in type_data.durations %}
                <option value="{{ days }}" {{ days == type_data.duration_days ? 'selected' }}>{{ trans(days == 1 ? 'auction.form.day' : 'auction.form.days', {days: days}) }}</option>
            {% endfor %}
        </select>
        <small>{{ trans('auction.form.duration_hint') }}</small>
    {% endif %}
</fieldset>
