{# Included on the public offer page and in the administration. Receives type_data. #}
<section class="auction">
    <h2>{{ trans('auction.detail.title') }}</h2>

    {% if type_data.status is null %}
        <p>{{ trans('auction.detail.pending') }}</p>
    {% else %}
        <ul class="card-list">
            <li>
                <strong>{{ trans(type_data.bid_count > 0 ? 'auction.detail.current' : 'auction.detail.start') }}</strong>
                <span class="price">{{ money(type_data.current_price ?? type_data.start_price, type_data.currency) }}</span>
                <small>{{ trans(type_data.bid_count == 1 ? 'auction.detail.bid' : 'auction.detail.bids', {count: type_data.bid_count}) }}</small>
            </li>
            <li>
                {% if type_data.running %}
                    {# countdown.js keeps this running; the text is complete without it. #}
                    <strong data-auction-ends="{{ type_data.ends_at_iso }}" data-auction-now="{{ type_data.now_iso }}" data-auction-template="{{ trans('auction.detail.left', {days: '{days}', hours: '{hours}', minutes: '{minutes}', seconds: '{seconds}'}) }}">{{ trans('auction.detail.left', type_data.left) }}</strong>
                    <script src="{{ ext_asset('auction', 'countdown.js') }}" defer></script>
                    <small>{{ trans('auction.detail.ends', {date: type_data.ends_at}) }}</small>
                {% elseif type_data.status == 'pending' %}
                    <strong>{{ trans('auction.detail.pending') }}</strong>
                    <small>{{ trans(type_data.duration_days == 1 ? 'auction.form.day' : 'auction.form.days', {days: type_data.duration_days}) }}</small>
                {% else %}
                    <strong>{{ trans('auction.detail.status.' ~ (type_data.status == 'open' ? 'closing' : type_data.status)) }}</strong>
                    {% if type_data.ends_at %}<small>{{ trans('auction.detail.ended', {date: type_data.ends_at}) }}</small>{% endif %}
                {% endif %}
            </li>
        </ul>

        {# "offer" comes from the page this is included in; the administration has no bidding. #}
        {% if type_data.running and offer.is_own is defined %}
            {% if offer.is_own %}
                <p>{{ trans('auction.bid.own') }}</p>
            {% elseif not account %}
                <p><a href="{{ url('/login') }}">{{ trans('auction.bid.login') }}</a></p>
            {% elseif type_data.is_leading %}
                <p class="flash flash-success">{{ trans('auction.bid.leading') }}</p>
            {% else %}
                <form method="post" action="{{ url('/auction/' ~ type_data.offer_id ~ '/bid') }}" class="stack-form">
                    {{ csrf_field() }}
                    <label for="amount">{{ trans('auction.bid.amount', {currency: type_data.currency}) }}</label>
                    <input id="amount" name="amount" value="{{ type_data.min_bid_input }}" inputmode="decimal" required>
                    <small>{{ trans('auction.bid.minimum', {min: money(type_data.min_bid, type_data.currency)}) }}</small>

                    {% if type_data.terms %}
                        <label class="checkbox">
                            <input type="checkbox" name="accept_terms" value="1" required>
                            <span>{{ trans('core.register.accept') }} <a href="{{ url(type_data.terms.path) }}" target="_blank" rel="noopener">{{ type_data.terms.title }}</a></span>
                        </label>
                    {% endif %}

                    {# The wording of this button states that a bid binds. Keep it in every theme. #}
                    <button type="submit">{{ trans('auction.bid.submit') }}</button>
                    <small>{{ trans('auction.bid.binding') }}</small>
                </form>
            {% endif %}
        {% endif %}

        {% if type_data.bids %}
            <h3>{{ trans('auction.detail.history') }}</h3>
            <ol reversed>
                {% for bid in type_data.bids %}
                    <li>
                        {{ money(bid.amount, type_data.currency) }} –
                        {{ bid.own ? trans('auction.detail.you') : trans('auction.detail.bidder', {number: bid.bidder}) }}
                        <small>{{ bid.created_at }} UTC</small>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    {% endif %}
</section>
