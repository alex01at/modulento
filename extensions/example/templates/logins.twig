{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('example.logins.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
<h1>{{ trans('example.logins.title') }}</h1>

{% if logins is empty %}
    <p>{{ trans('example.logins.none') }}</p>
{% else %}
    <table>
        <thead>
        <tr>
            <th scope="col">{{ trans('example.logins.account') }}</th>
            <th scope="col">{{ trans('example.logins.time') }}</th>
        </tr>
        </thead>
        <tbody>
        {% for login in logins %}
            <tr>
                <td>{{ login.account_id }}</td>
                <td>{{ login.logged_in_at }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
