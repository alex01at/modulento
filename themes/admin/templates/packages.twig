{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.package.title') }} – {{ site_name }}{% endblock %}

{% macro switch(item) %}
    {# Extensions are switched on and off; a theme is chosen, and "off" means back to the default theme. #}
    <form method="post" action="{{ url('/admin/packages/' ~ item.kind ~ '/' ~ item.id ~ '/' ~ (item.in_use ? 'disable' : 'enable')) }}">
        {{ csrf_field() }}
        <button type="submit" class="btn-sm">{{ trans(item.in_use ? 'core.admin.extensions.disable' : 'core.admin.extensions.enable') }}</button>
    </form>
{% endmacro %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: trans('core.package.title')} only %}

<section class="card-box">
    <div class="card-head">
        <p>{{ trans('core.package.intro') }}</p>
    </div>

    {% if packages is empty %}
        <p>{{ trans('core.package.none_installed') }}</p>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th scope="col">{{ trans('core.admin.extensions.name') }}</th>
                    <th scope="col">{{ trans('core.package.kind') }}</th>
                    <th scope="col">{{ trans('core.package.source') }}</th>
                    <th scope="col">{{ trans('core.admin.extensions.version') }}</th>
                    <th scope="col"></th>
                </tr>
                </thead>
                <tbody>
                {% for package in packages %}
                    <tr>
                        <th scope="row">{{ package.id }} <span class="badge badge-{{ package.in_use ? 'enabled' : 'disabled' }}">{{ trans(package.in_use ? 'core.package.active' : 'core.package.inactive') }}</span></th>
                        <td>{{ trans('core.package.kind.' ~ package.kind) }}</td>
                        <td>{{ package.repo }}</td>
                        <td>
                            {{ package.version }}
                            {% if package.latest and package.latest != package.version %}
                                <span class="badge badge-pending">{{ trans('core.package.newer', {version: package.latest}) }}</span>
                            {% elseif package.latest %}
                                <span class="badge badge-ok">{{ trans('core.package.current') }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="button-row">
                                {{ _self.switch(package) }}
                                {# Always there: without a known newer version it asks the repository first. #}
                                <form method="post" action="{{ url('/admin/packages/' ~ package.kind ~ '/' ~ package.id ~ '/update') }}">
                                    {{ csrf_field() }}
                                    <button type="submit" class="btn-sm">{{ package.latest and package.latest != package.version ? trans('core.package.update', {version: package.latest}) : trans('core.package.update_now') }}</button>
                                </form>
                                {% if not package.in_use %}
                                    <form method="post" action="{{ url('/admin/packages/' ~ package.kind ~ '/' ~ package.id ~ '/remove') }}">
                                        {{ csrf_field() }}
                                        <button type="submit" class="btn-sm danger">{{ trans('core.package.remove') }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <form method="post" action="{{ url('/admin/packages/check') }}">
            {{ csrf_field() }}
            <button type="submit">{{ trans('core.update.check') }}</button>
        </form>
    {% endif %}
</section>

{% if unmanaged %}
<section class="card-box">
    <h2>{{ trans('core.package.unmanaged_title') }}</h2>
    <p>{{ trans('core.package.unmanaged_hint') }}</p>
    <div class="table-wrap">
        <table>
            <tbody>
            {% for item in unmanaged %}
                <tr>
                    <th scope="row">{{ item.id }} <span class="badge badge-{{ item.in_use ? 'enabled' : 'disabled' }}">{{ trans(item.in_use ? 'core.package.active' : 'core.package.inactive') }}</span></th>
                    <td>{{ trans('core.package.kind.' ~ item.kind) }}</td>
                    <td>{{ _self.switch(item) }}</td>
                    <td>
                        <form method="post" action="{{ url('/admin/packages/install') }}" class="button-row">
                            {{ csrf_field() }}
                            <label class="visually-hidden" for="adopt_{{ item.kind }}_{{ item.id }}">{{ trans('core.package.repo') }}</label>
                            <input id="adopt_{{ item.kind }}_{{ item.id }}" name="repo" value="{{ item.repo }}" required>
                            <button type="submit" class="btn-sm">{{ trans('core.package.adopt') }}</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endif %}

{% if official %}
<section class="card-box">
    <h2>{{ trans('core.package.official_title') }}</h2>
    <p>{{ trans('core.package.official_hint') }}</p>
    <div class="table-wrap">
        <table>
            <tbody>
            {% for item in official %}
                <tr>
                    <th scope="row">{{ item.id }}</th>
                    <td>{{ trans('core.package.kind.' ~ item.kind) }}</td>
                    <td>{{ trans(item.key) }}<br><small>{{ item.repo }}</small></td>
                    <td>
                        <form method="post" action="{{ url('/admin/packages/install') }}">
                            {{ csrf_field() }}
                            <input type="hidden" name="repo" value="{{ item.repo }}">
                            <button type="submit" class="btn-sm">{{ trans('core.package.install') }}</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endif %}

<section class="card-box">
    <h2>{{ trans('core.package.install_title') }}</h2>
    <p>{{ trans('core.package.install_hint') }}</p>
    <form method="post" action="{{ url('/admin/packages/install') }}" class="stack-form">
        {{ csrf_field() }}
        <label for="repo">{{ trans('core.package.repo') }}</label>
        <input id="repo" name="repo" placeholder="owner/modulento-theme-name" required>
        <small>{{ trans('core.package.sources', {sources: sources|join(', ')}) }}</small>
        <button type="submit">{{ trans('core.package.install') }}</button>
    </form>
</section>
{% endblock %}
