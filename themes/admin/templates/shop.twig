{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.admin.shop.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: trans('core.admin.shop.title')} only %}

{% if purchase %}
    <section class="card-box">
        {% if purchase.status == 'pending' %}
            <p class="flash">{{ trans('core.admin.shop.purchase_pending') }}</p>
            <p><a href="{{ url('/admin/shop') }}?purchase={{ purchase.reference }}">{{ trans('core.admin.shop.purchase_refresh') }}</a></p>
        {% elseif purchase.status == 'completed' and purchase.license_key %}
            <p class="flash flash-success">{{ trans('core.admin.shop.purchase_done', {product: purchase.product}) }}</p>
            <p><a href="{{ url('/admin/packages') }}">{{ trans('core.admin.shop.go_install') }}</a></p>
        {% elseif purchase.status == 'completed' %}
            <p class="flash flash-success">{{ trans('core.admin.shop.purchase_already_saved') }}</p>
        {% else %}
            <p class="flash flash-error">{{ trans('core.admin.shop.purchase_not_found') }}</p>
        {% endif %}
    </section>
{% endif %}

{% if enabled %}
<section class="card-box">
    <h2>{{ trans('core.admin.shop.master_title') }}</h2>
    <p>{{ trans('core.admin.shop.master_intro') }}</p>
    {% if master_license %}
        <p>{{ trans('core.admin.shop.master_current', {masked: master_license}) }}</p>
        <form method="post" action="{{ url('/admin/shop/master/remove') }}">
            {{ csrf_field() }}
            <button type="submit">{{ trans('core.admin.shop.master_remove') }}</button>
        </form>
    {% else %}
        <form method="post" action="{{ url('/admin/shop/master') }}" class="stack-form">
            {{ csrf_field() }}
            <label for="license_key">{{ trans('core.license.key') }}</label>
            <input id="license_key" name="license_key" type="text" required>
            <button type="submit">{{ trans('core.admin.shop.master_save') }}</button>
        </form>
    {% endif %}
</section>
{% endif %}

<section class="card-box">
    <p>{{ trans('core.admin.shop.intro') }}</p>

    {% if not enabled %}
        <p class="empty">{{ trans('core.admin.shop.no_server') }}</p>
    {% elseif products is empty %}
        <p class="empty">{{ trans('core.admin.shop.none') }}</p>
    {% else %}
        <div class="columns">
            {% for product in products %}
                <div class="card-box">
                    {% if product.screenshot_url %}
                        <img src="{{ product.screenshot_url }}" alt="" loading="lazy">
                    {% endif %}
                    <h3>{{ product.name }}</h3>
                    {% if product.description %}<p>{{ product.description }}</p>{% endif %}
                    <p><strong>{{ money(product.price_cents, product.currency) }}</strong></p>
                    {% if master_license %}
                        <form method="post" action="{{ url('/admin/shop/' ~ product.id ~ '/install') }}">
                            {{ csrf_field() }}
                            <button type="submit">{{ trans('core.admin.shop.install') }}</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ url('/admin/shop/' ~ product.id ~ '/buy') }}">
                            {{ csrf_field() }}
                            <button type="submit">{{ trans('core.admin.shop.buy') }}</button>
                        </form>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
