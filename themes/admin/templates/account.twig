{% extends '@admin/layout.twig' %}

{% block title %}{{ target.email }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: target.email, crumbs: [{label: trans('core.admin.accounts.title'), path: '/admin/accounts'}]} only %}

<div class="split">
    <div>
        <section class="card-box">
            <h2>{{ trans('core.admin.layout.details') }}</h2>
            <div class="table-wrap">
                <table class="details">
                    <tr><th scope="row">{{ trans('core.account.profile.display_name') }}</th><td>{{ target.display_name }}</td></tr>
                    <tr><th scope="row">{{ trans('core.admin.extensions.status') }}</th><td><span class="badge badge-{{ target.status }}">{{ trans('core.admin.accounts.status.' ~ target.status) }}</span>{% if target.status_note %} – {{ target.status_note }}{% endif %}</td></tr>
                    <tr><th scope="row">{{ trans('core.admin.accounts.verified_at') }}</th><td>{{ target.email_verified_at ? target.email_verified_at ~ ' UTC' : trans('core.admin.accounts.unverified') }}</td></tr>
                    <tr><th scope="row">{{ trans('core.nav.language') }}</th><td>{{ locale_name(target.locale) }}</td></tr>
                    <tr><th scope="row">{{ trans('core.admin.providers.created') }}</th><td>{{ target.created_at }} UTC</td></tr>
                    <tr><th scope="row">{{ trans('core.admin.accounts.last_login') }}</th><td>{{ target.last_login_at ? target.last_login_at ~ ' UTC' : '–' }}</td></tr>
                    <tr><th scope="row">{{ trans('core.admin.accounts.terms') }}</th><td>{{ target.terms_accepted_at ? target.terms_accepted_at ~ ' UTC' : '–' }}</td></tr>
                    <tr><th scope="row">{{ trans('core.provider.title') }}</th><td>{% if provider %}<a href="{{ url('/admin/providers/' ~ provider.id) }}">{{ provider.name }}</a> ({{ trans('core.provider.status_short.' ~ provider.status) }}){% else %}–{% endif %}</td></tr>
                </table>
            </div>
        </section>

        {% if can('core.roles.manage') %}
            <section class="card-box">
                <h2>{{ trans('core.admin.roles.title') }}</h2>
                <form method="post" action="{{ url('/admin/accounts/' ~ target.id ~ '/roles') }}" class="stack-form wide">
                    {{ csrf_field() }}
                    <div class="check-list">
                        {% for role in roles %}
                            <label class="checkbox">
                                <input type="checkbox" name="roles[]" value="{{ role.id }}" {{ role.id in role_ids ? 'checked' }}>
                                <span>{{ role.name }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    <button type="submit">{{ trans('core.account.save') }}</button>
                </form>
            </section>
        {% endif %}
    </div>

    <div>
        <section class="card-box">
            <h2>{{ trans('core.account.identity.title') }}</h2>
            <p><span class="badge badge-{{ target.identity_status }}">{{ trans('core.account.identity.status.' ~ target.identity_status) }}</span>
                {% if target.identity_decided_at %}<small>({{ target.identity_decided_at }} UTC)</small>{% endif %}</p>
            {% if target.identity_note %}<p>{{ target.identity_note }}</p>{% endif %}
            {% if identity_documents %}
                <ul class="plain-list">
                    {% for document in identity_documents %}
                        <li><a href="{{ url('/admin/accounts/' ~ target.id ~ '/identity/files/' ~ document.id) }}">{{ document.name }}</a> <small>({{ (document.size / 1024)|round }} KB, {{ document.created_at }} UTC)</small></li>
                    {% endfor %}
                </ul>
                {% if target.identity_status == 'pending' %}
                    <form method="post" action="{{ url('/admin/accounts/' ~ target.id ~ '/identity/decide') }}" class="stack-form wide">
                        {{ csrf_field() }}
                        <div class="field">
                            <label for="identity_note">{{ trans('core.admin.accounts.identity.note') }}</label>
                            <textarea id="identity_note" name="note" rows="3"></textarea>
                            <small>{{ trans('core.admin.accounts.identity.note_hint') }}</small>
                        </div>
                        <div class="button-row">
                            <button type="submit" name="decision" value="verify">{{ trans('core.admin.accounts.identity.verify') }}</button>
                            <button type="submit" name="decision" value="reject" class="danger">{{ trans('core.admin.accounts.identity.reject') }}</button>
                        </div>
                    </form>
                {% endif %}
            {% else %}
                <p class="empty">{{ trans('core.account.identity.none') }}</p>
            {% endif %}
        </section>

        <section class="card-box">
            <h2>{{ trans('core.admin.accounts.actions') }}</h2>
            <div class="button-row">
            {% if not target.email_verified_at %}
                <form method="post" action="{{ url('/admin/accounts/' ~ target.id ~ '/verify') }}" class="inline-form">
                    {{ csrf_field() }}
                    <button type="submit">{{ trans('core.admin.accounts.verify') }}</button>
                </form>
            {% endif %}
                <form method="post" action="{{ url('/admin/accounts/' ~ target.id ~ '/reset') }}" class="inline-form">
                    {{ csrf_field() }}
                    <button type="submit" class="btn-outline">{{ trans('core.admin.accounts.send_reset') }}</button>
                </form>
            {% if target.status == 'blocked' %}
                <form method="post" action="{{ url('/admin/accounts/' ~ target.id ~ '/unblock') }}" class="inline-form">
                    {{ csrf_field() }}
                    <button type="submit">{{ trans('core.admin.accounts.unblock') }}</button>
                </form>
            {% endif %}
            </div>
        </section>

        <section class="card-box">
            <h2>{{ trans('core.admin.layout.danger_zone') }}</h2>
            {% if is_self or is_last_admin %}
                <p><small>{{ trans('core.admin.accounts.protected_hint') }}</small></p>
            {% else %}
                {% if target.status == 'active' %}
                    <form method="post" action="{{ url('/admin/accounts/' ~ target.id ~ '/block') }}" class="danger-form">
                        {{ csrf_field() }}
                        <div class="field">
                            <label for="note">{{ trans('core.admin.accounts.block_note') }}</label>
                            <textarea id="note" name="note" rows="3" required></textarea>
                        </div>
                        <button type="submit" class="danger">{{ trans('core.admin.accounts.block') }}</button>
                    </form>
                {% endif %}
                <form method="post" action="{{ url('/admin/accounts/' ~ target.id ~ '/delete') }}" class="danger-form">
                    {{ csrf_field() }}
                    <p><small>{{ trans('core.admin.accounts.delete_hint') }}</small></p>
                    <button type="submit" class="danger">{{ trans('core.account.delete.submit') }}</button>
                </form>
            {% endif %}
        </section>
    </div>
</div>

{% if module('subscriptions') and can('core.settings.manage') and provider %}
<section class="card-box">
    <h2>{{ trans('core.admin.subscriptions.assign.title') }}</h2>
    <p>
        {% if subscription %}
            {{ subscription.name }} – {{ subscription.period_end ? trans('core.account.subscription.until', {date: subscription.period_end}) : trans('core.account.subscription.open') }}
        {% else %}
            {{ trans('core.account.subscription.none') }}
        {% endif %}
    </p>
    <form method="post" action="{{ url('/admin/subscriptions/assign') }}" class="stack-form wide">
        {{ csrf_field() }}
        <input type="hidden" name="email" value="{{ target.email }}">
        <input type="hidden" name="return" value="{{ url('/admin/accounts/' ~ target.id) }}">
        <label for="assign-plan">{{ trans('core.admin.subscriptions.assign.plan') }}</label>
        <select id="assign-plan" name="plan">
            <option value="">{{ trans('core.admin.subscriptions.assign.none') }}</option>
            {% for plan in plans|filter(p => p.active) %}
                <option value="{{ plan.id }}" {{ subscription and subscription.slug == plan.slug ? 'selected' }}>{{ plan.name }}</option>
            {% endfor %}
        </select>
        <label for="assign-until">{{ trans('core.admin.subscriptions.assign.until') }}</label>
        <input id="assign-until" name="until" type="date">
        <small>{{ trans('core.admin.subscriptions.assign.until_hint') }}</small>
        <button type="submit">{{ trans('core.admin.subscriptions.assign.submit') }}</button>
    </form>
</section>
{% endif %}

{% if can_impersonate and target.status == 'active' %}
<section class="card-box">
    <h2>{{ trans('core.admin.accounts.impersonate') }}</h2>
    <p>{{ trans('core.admin.accounts.impersonate_hint') }}</p>
    <form method="post" action="{{ url('/admin/accounts/' ~ target.id ~ '/impersonate') }}">
        {{ csrf_field() }}
        <button type="submit" class="btn-outline">{{ trans('core.admin.accounts.impersonate') }}</button>
    </form>
</section>
{% endif %}

<section class="card-box">
    <h2>{{ trans('core.admin.accounts.activity') }}</h2>
    {% if activity %}
        <ul class="plain-list">
            {% for entry in activity %}
                <li>{{ entry.created_at }} UTC – {{ trans('core.admin.log.' ~ entry.action) }}{% if entry.actor_id %} ({{ trans('core.admin.log.by') }} #{{ entry.actor_id }}){% endif %}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="empty">{{ trans('core.admin.accounts.activity_empty') }}</p>
    {% endif %}
</section>
{% endblock %}
