{% import '@admin/_icons.twig' as icons %}
<!DOCTYPE html>
{# The account's own choice of colour scheme; without one the device decides. #}
{% set scheme = color_scheme() %}
<html lang="{{ locale() }}"{% if scheme != 'auto' %} data-theme="{{ scheme }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{% block title %}{{ trans('core.admin.title') }} – {{ site_name }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ admin_asset('admin.css') }}">
    <script src="{{ admin_asset('admin.js') }}"></script>
    <script src="{{ admin_asset('editor.js') }}" defer></script>
    <script src="{{ theme_asset('account-menu.js') }}" defer></script>
    {# The same script as on the site: a "show" button next to every password field. #}
    <script src="{{ admin_asset('password-toggle.js') }}" defer data-show="{{ trans('core.password.show') }}" data-hide="{{ trans('core.password.hide') }}"></script>
    {% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#content">{{ trans('core.admin.layout.skip') }}</a>

<aside class="sidebar" id="sidebar">
    <div class="sidebar-head">
        <a class="brand" href="{{ url('/admin') }}">
            <span class="brand-mark">{{ icons.icon('brand') }}</span>
            <span class="brand-name">{{ site_name }}</span>
        </a>
        <button type="button" class="sidebar-close" data-sidebar-close>
            {{ icons.icon('close') }}
            <span class="visually-hidden">{{ trans('core.admin.layout.menu_close') }}</span>
        </button>
    </div>
    <nav class="admin-menu" aria-label="{{ trans('core.nav.admin') }}">
        {% set here = current_path() %}
        <a href="{{ url('/admin') }}" {{ here == '/admin' ? 'aria-current="page"' }}>{{ icons.menu('/admin') }}<span>{{ trans('core.admin.dashboard.title') }}</span></a>
        {% for group in admin_menu_groups %}
            <p class="admin-menu-group" id="menu-group-{{ group.id }}">{{ trans(group.label_key) }}</p>
            <div role="group" aria-labelledby="menu-group-{{ group.id }}">
                {% for item in group.items %}
                    <a href="{{ url(item.path) }}" {{ here == item.path or here starts with (item.path ~ '/') ? 'aria-current="page"' }}>{{ icons.menu(item.path) }}<span>{{ trans(item.label_key) }}</span></a>
                {% endfor %}
            </div>
        {% endfor %}
    </nav>
</aside>
<div class="sidebar-backdrop" data-sidebar-close></div>

<div class="page">
    <header class="topbar">
        <button type="button" class="menu-toggle" data-sidebar-toggle aria-controls="sidebar" aria-expanded="false">
            {{ icons.icon('menu') }}
            <span class="visually-hidden">{{ trans('core.admin.layout.menu_toggle') }}</span>
        </button>
        <nav class="topbar-nav" aria-label="{{ trans('core.nav.home') }}">
            {% for language in locale_urls() %}
                {% if not language.current %}
                    <a class="topbar-link" href="{{ language.url }}" hreflang="{{ language.locale }}" lang="{{ language.locale }}">{{ icons.icon('globe') }}<span>{{ language.name }}</span></a>
                {% endif %}
            {% endfor %}
            <a class="topbar-link" href="{{ url('/') }}" target="_blank" rel="noopener">{{ icons.icon('external') }}<span class="topbar-label">{{ trans('core.nav.to_site') }}</span></a>
            {# The same menu as on the site: picture, settings, colour scheme, log out. #}
            {% if account %}
                {% include 'layout/_account_menu.twig' %}
            {% endif %}
        </nav>
    </header>

    <main id="content" class="admin-content" tabindex="-1">
        {% for type, message in flashes %}
            <p class="flash flash-{{ type }}" role="status">{{ message }}</p>
        {% endfor %}
        {% block admin %}{% endblock %}
    </main>
</div>
</body>
</html>
