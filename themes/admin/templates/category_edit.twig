{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.admin.categories.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
<p><a href="{{ url('/admin/categories') }}">{{ trans('core.admin.categories.title') }}</a></p>
<h1>{{ category and category.id ? trans('core.admin.categories.edit') : trans('core.admin.categories.new') }}</h1>

{% for error in errors %}
    <p class="flash flash-error" role="alert">{{ error }}</p>
{% endfor %}

<form method="post" action="{{ url(category and category.id ? '/admin/categories/' ~ category.id : '/admin/categories/new') }}" class="stack-form wide">
    {{ csrf_field() }}

    {% for code in locales %}
        {% set text = category ? (category.translations[code] ?? {}) : {} %}
        <fieldset>
            <legend>{{ locale_name(code) }}</legend>
            <label for="name_{{ code }}">{{ trans('core.admin.extensions.name') }}</label>
            <input id="name_{{ code }}" name="text[{{ code }}][name]" value="{{ text.name ?? '' }}" maxlength="150" lang="{{ code }}" {{ loop.first ? 'required' }}>
            <label for="slug_{{ code }}">{{ trans('core.admin.pages.field.slug') }}</label>
            <input id="slug_{{ code }}" name="text[{{ code }}][slug]" value="{{ text.slug ?? '' }}" maxlength="160">
        </fieldset>
    {% endfor %}

    <label for="parent_id">{{ trans('core.admin.categories.parent') }}</label>
    <select id="parent_id" name="parent_id">
        <option value="">{{ trans('core.admin.categories.parent_none') }}</option>
        {% for parent in parents %}
            <option value="{{ parent.id }}" {{ category and category.parent_id == parent.id ? 'selected' }}>{{ parent.name }}</option>
        {% endfor %}
    </select>

    <label for="position">{{ trans('core.admin.pages.field.position') }}</label>
    <input id="position" name="position" type="number" value="{{ category ? category.position : 0 }}">

    <button type="submit">{{ trans('core.account.save') }}</button>
</form>

{% if category and category.id %}
    <form method="post" action="{{ url('/admin/categories/' ~ category.id ~ '/delete') }}">
        {{ csrf_field() }}
        <p><small>{{ trans('core.admin.categories.delete_hint') }}</small></p>
        <button type="submit" class="danger">{{ trans('core.admin.categories.delete') }}</button>
    </form>
{% endif %}
{% endblock %}
