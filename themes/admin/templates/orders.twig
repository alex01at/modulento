{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.admin.orders.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: trans('core.admin.orders.title')} only %}

<section class="card-box">
    <nav class="tabs" aria-label="{{ trans('core.admin.layout.filter') }}">
        <a href="{{ url('/admin/orders') }}" {{ state is null ? 'aria-current="page"' }}>{{ trans('core.admin.providers.all') }}</a>
        {% for name, count in counts %}
            <a href="{{ url('/admin/orders') }}?state={{ name }}" {{ state == name ? 'aria-current="page"' }}>{{ name }} ({{ count }})</a>
        {% endfor %}
    </nav>

    {% if orders is empty %}
        <p class="empty">{{ trans('core.order.list.none') }}</p>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th scope="col">{{ trans('core.order.number') }}</th>
                    <th scope="col">{{ trans('core.offer.field.title') }}</th>
                    <th scope="col">{{ trans('core.order.buyer') }}</th>
                    <th scope="col">{{ trans('core.provider.field.name') }}</th>
                    <th scope="col">{{ trans('core.offer.field.status') }}</th>
                    <th scope="col" class="amount">{{ trans('core.order.total') }}</th>
                </tr>
                </thead>
                <tbody>
                {% for order in orders %}
                    <tr>
                        <th scope="row"><a href="{{ url('/admin/orders/' ~ order.id) }}">{{ order.number }}</a></th>
                        <td>{{ order.offer_title }}</td>
                        <td>{{ order.buyer_name }}</td>
                        <td>{{ order.provider_name }}</td>
                        <td><span class="badge">{{ trans(order.state_label_key) }}</span></td>
                        <td class="amount">{{ money(order.total, order.currency) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% include '@admin/_pager.twig' with {path: '/admin/orders', page: page, pages: pages, extra: state ? '&state=' ~ state : ''} only %}
    {% endif %}
</section>
{% endblock %}
