{% extends '@admin/layout.twig' %}
{% import '@admin/_icons.twig' as icons %}

{% block title %}{{ trans('core.admin.custom_fields.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: trans('core.admin.custom_fields.title')} only %}

<section class="card-box">
    <div class="card-head">
        <p>{{ trans('core.admin.custom_fields.intro') }}</p>
        <a class="btn" href="{{ url('/admin/custom-fields/new') }}?entity={{ entity }}">{{ icons.icon('plus') }}<span>{{ trans('core.admin.custom_fields.new') }}</span></a>
    </div>

    <nav class="tabs" aria-label="{{ trans('core.admin.layout.filter') }}">
        <a href="{{ url('/admin/custom-fields') }}?entity=offer" {{ entity == 'offer' ? 'aria-current="page"' }}>{{ trans('core.admin.custom_fields.entity_offer') }}</a>
        <a href="{{ url('/admin/custom-fields') }}?entity=provider" {{ entity == 'provider' ? 'aria-current="page"' }}>{{ trans('core.admin.custom_fields.entity_provider') }}</a>
    </nav>

    {% if fields is empty %}
        <p class="empty">{{ trans('core.admin.custom_fields.none') }}</p>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>{{ trans('core.admin.custom_fields.field_label') }}</th>
                        <th>{{ trans('core.admin.custom_fields.field_type') }}</th>
                        <th>{{ trans('core.admin.custom_fields.field_required') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for field in fields %}
                        <tr>
                            <td><a href="{{ url('/admin/custom-fields/' ~ field.id) }}?entity={{ entity }}">{{ field.label }}</a></td>
                            <td>{{ trans('core.admin.custom_fields.type.' ~ field.type) }}</td>
                            <td>{{ field.required ? trans('core.custom_field.checkbox.yes') : trans('core.custom_field.checkbox.no') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
{% endblock %}
