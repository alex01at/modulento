<svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ (shapes[name] ?? shapes.default)|raw }}</svg>
{%- endmacro %}

{# The icon of an administration menu entry, chosen by its path. Entries of
   extensions get the neutral default. #}
{% macro menu(path) %}
{% set names = {
    '/admin': 'dashboard',
    '/admin/settings': 'settings',
    '/admin/payments': 'payments',
    '/admin/pages': 'pages',
    '/admin/media': 'media',
    '/admin/orders': 'orders',
    '/admin/withdrawals': 'withdrawals',
    '/admin/reviews': 'reviews',
    '/admin/reports': 'reports',
    '/admin/offers': 'offers',
    '/admin/categories': 'categories',
    '/admin/providers': 'providers',
    '/admin/accounts': 'accounts',
    '/admin/roles': 'roles',
    '/admin/extensions': 'extensions',
    '/admin/themes': 'themes',
    '/admin/packages': 'updates',
    '/admin/tasks': 'tasks',
    '/admin/updates': 'updates'
} %}
{{ _self.icon(names[path] ?? 'default') }}
{%- endmacro %}
