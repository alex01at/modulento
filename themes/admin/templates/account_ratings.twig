{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.admin.account_ratings.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: trans('core.admin.account_ratings.title')} only %}

<section class="card-box">
    <div class="card-head">
        <p>{{ trans('core.admin.account_ratings.intro') }}</p>
    </div>

    <nav class="tabs" aria-label="{{ trans('core.admin.layout.filter') }}">
        <a href="{{ url('/admin/account-ratings') }}" {{ status is null ? 'aria-current="page"' }}>{{ trans('core.admin.providers.all') }}</a>
        {% for name in ['published', 'hidden'] %}
            <a href="{{ url('/admin/account-ratings') }}?status={{ name }}" {{ status == name ? 'aria-current="page"' }}>{{ trans('core.admin.reviews.status.' ~ name) }}</a>
        {% endfor %}
    </nav>

    {% if ratings is empty %}
        <p class="empty">{{ trans('core.admin.account_ratings.none') }}</p>
    {% endif %}
</section>

{% for rating in ratings %}
    <article class="card-box review-admin">
        <div class="review-head">
            <strong class="rating">{{ rating.rating }} / 5</strong>
            <span class="badge badge-{{ rating.status }}">{{ trans('core.admin.reviews.status.' ~ rating.status) }}</span>
            {{ trans('core.admin.account_ratings.rated') }}: {{ rating.rated_name ?: rating.rated_email }} ·
            <small>{{ rating.rater_name ?: trans('core.account_rating.anonymous') }}, {{ rating.created_at }} UTC</small>
        </div>
        {% if rating.body %}<p>{{ rating.body|nl2br }}</p>{% endif %}
        {% if rating.reply %}<p class="quote"><small>{{ trans('core.account_rating.reply_by_rated') }}</small><br>{{ rating.reply|nl2br }}</p>{% endif %}
        {% if rating.status_note %}<p><small>{{ trans('core.provider.status_note') }} {{ rating.status_note }}</small></p>{% endif %}

        {% if rating.status == 'published' %}
            <form method="post" action="{{ url('/admin/account-ratings/' ~ rating.id ~ '/hide') }}" class="stack-form wide">
                {{ csrf_field() }}
                <div class="field">
                    <label for="note_{{ rating.id }}">{{ trans('core.admin.account_ratings.note') }}</label>
                    <textarea id="note_{{ rating.id }}" name="note" rows="2" required></textarea>
                </div>
                <button type="submit" class="danger">{{ trans('core.admin.account_ratings.hide') }}</button>
            </form>
        {% else %}
            <form method="post" action="{{ url('/admin/account-ratings/' ~ rating.id ~ '/show') }}">
                {{ csrf_field() }}
                <button type="submit">{{ trans('core.admin.account_ratings.show') }}</button>
            </form>
        {% endif %}
    </article>
{% endfor %}

{% include '@admin/_pager.twig' with {path: '/admin/account-ratings', page: page, pages: pages, extra: status ? '&status=' ~ status : ''} only %}
{% endblock %}
