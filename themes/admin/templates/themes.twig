{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.admin.themes.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: trans('core.admin.themes.title')} only %}

<section class="card-box">
    <div class="card-head">
        <p>{{ trans('core.admin.themes.intro') }}</p>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th scope="col">{{ trans('core.admin.extensions.name') }}</th>
                <th scope="col">{{ trans('core.admin.extensions.version') }}</th>
                <th scope="col">{{ trans('core.admin.extensions.status') }}</th>
                <th scope="col"></th>
            </tr>
            </thead>
            <tbody>
            {% for theme in themes %}
                <tr>
                    <th scope="row">{{ theme.name }} <small>({{ theme.id }})</small></th>
                    <td>{{ theme.version }}</td>
                    <td>
                        {% if theme.id == active %}
                            <span class="badge badge-enabled">{{ trans('core.admin.extensions.status_enabled') }}</span>
                        {% else %}
                            <span class="badge badge-disabled">{{ trans('core.admin.extensions.status_disabled') }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if theme.id != active %}
                            <form method="post" action="{{ url('/admin/themes/' ~ theme.id ~ '/activate') }}">
                                {{ csrf_field() }}
                                <button type="submit" class="btn-sm">{{ trans('core.admin.extensions.enable') }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>

<section class="card-box">
    <div class="card-head">
        <h2>{{ trans('core.admin.branding.title') }}</h2>
        <p>{{ trans('core.admin.branding.intro') }}</p>
    </div>

    <div class="field-grid">
        {% for kind in ['logo_light', 'logo_dark', 'favicon'] %}
            {% set current = kind == 'logo_light' ? site_logo('light') : (kind == 'logo_dark' ? site_logo('dark') : site_favicon()) %}
            {# site_logo('dark') falls back to the light logo once one exists, so compare against the kind's own file to show the right state here. #}
            {% set own = branding[kind] %}
            <div class="field">
                <label for="branding_{{ kind }}">{{ trans('core.admin.branding.' ~ kind) }}</label>
                <p class="branding-preview">
                    {% if own %}
                        <img src="{{ current }}" alt="">
                    {% else %}
                        <span class="muted">{{ trans('core.admin.branding.none') }}</span>
                    {% endif %}
                </p>
                <form method="post" action="{{ url('/admin/branding/' ~ kind) }}" enctype="multipart/form-data" class="button-row">
                    {{ csrf_field() }}
                    <input id="branding_{{ kind }}" name="file" type="file" accept="image/jpeg,image/png,image/webp" required>
                    <button type="submit" class="btn-sm">{{ trans('core.admin.branding.upload') }}</button>
                </form>
                {% if own %}
                    <form method="post" action="{{ url('/admin/branding/' ~ kind ~ '/delete') }}">
                        {{ csrf_field() }}
                        <button type="submit" class="link-button">{{ trans('core.admin.branding.remove') }}</button>
                    </form>
                {% endif %}
                <small>{{ trans('core.admin.branding.' ~ kind ~ '_hint') }}</small>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}
