{# One block while the page is edited in place: its tools, the block itself, and the "+" after it.
   The block's own partial is drawn inside, so the page's loop stays the same for every theme.
   Texts marked with data-field are edited on the spot (JavaScript); the form below them works
   without scripts too. Receives block, page_path, partial, fields, label_key, deletable, add_types,
   and optionally permission (default core.settings.manage, see _bar.twig). #}
{% set id = block.id %}
{% set permission = permission|default('core.settings.manage') %}
<div class="inline-block{{ block.enabled ? '' : ' is-hidden-block' }}" id="inline-{{ id }}" data-block-id="{{ id }}"
     data-field-url="{{ url(page_path) }}/field" data-order-url="{{ url(page_path) }}/order" data-csrf="{{ csrf_token() }}">
    <div class="inline-tools">
        <div class="inline-head">
            <p class="inline-name">
                <span class="inline-grip" title="{{ trans('core.inline.move') }}" aria-hidden="true">⠿</span>
                <strong>{{ trans(label_key) }}</strong>
                {% if not block.enabled %}<span class="badge badge-disabled">{{ trans('core.inline.hidden') }}</span>{% endif %}
            </p>

            <form method="post" action="{{ url(page_path) }}" class="inline-steps">
                {{ csrf_field() }}
                <input type="hidden" name="return" value="{{ current_path() }}?edit=1">
                <button type="submit" name="action" value="up:{{ id }}" class="btn-outline btn-sm" aria-label="{{ trans('core.home.up') }}">↑</button>
                <button type="submit" name="action" value="down:{{ id }}" class="btn-outline btn-sm" aria-label="{{ trans('core.home.down') }}">↓</button>
                <button type="submit" name="action" value="toggle:{{ id }}" class="btn-outline btn-sm">{{ block.enabled ? trans('core.inline.hide') : trans('core.inline.show') }}</button>
                <button type="submit" name="action" value="duplicate:{{ id }}" class="btn-outline btn-sm">{{ trans('core.inline.duplicate') }}</button>
                {% if deletable %}
                    <button type="submit" name="action" value="delete:{{ id }}" class="danger btn-sm">{{ trans('core.home.remove') }}</button>
                {% endif %}
            </form>
        </div>

        <details class="inline-widget">
            <summary>{{ trans('core.widget.save') }}</summary>
            <form method="post" action="{{ url(page_path) }}" class="inline-widget-form">
                {{ csrf_field() }}
                <input type="hidden" name="return" value="{{ current_path() }}?edit=1">
                <label for="widget-name-{{ id }}">{{ trans('core.widget.name') }}</label>
                <input id="widget-name-{{ id }}" name="widget_name" maxlength="60" required>
                <button type="submit" name="action" value="savewidget:{{ id }}">{{ trans('core.widget.save') }}</button>
            </form>
        </details>

        {% if fields %}
            <details class="inline-edit">
                <summary>{{ trans('core.inline.edit') }}</summary>
                <form method="post" action="{{ url(page_path) }}" class="inline-edit-form">
                    {{ csrf_field() }}
                    <input type="hidden" name="return" value="{{ current_path() }}?edit=1">
                    {% if block.enabled %}<input type="hidden" name="blocks[{{ id }}][enabled]" value="1">{% endif %}
                    {% if block.type == 'offers' or block.type == 'providers' or block.type == 'pages' %}
                        <div class="field">
                            <label for="count-{{ id }}">{{ trans('core.home.count') }}</label>
                            <input id="count-{{ id }}" name="blocks[{{ id }}][settings][count]" type="number" min="1" max="12" value="{{ block.count }}">
                        </div>
                    {% elseif block.type == 'image' %}
                        <div class="field">
                            <label for="media-{{ id }}">{{ trans('core.home.picture') }}</label>
                            <select id="media-{{ id }}" name="blocks[{{ id }}][settings][media]">
                                <option value="">{{ trans('core.home.picture_none') }}</option>
                                {% for picture in library_pictures() %}
                                    <option value="{{ picture.url }}" {{ picture.url == block.media ? 'selected' }}>{{ picture.title ?: picture.url }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                    <fieldset>
                        <legend>{{ trans('core.home.background') }}</legend>
                        <div class="field">
                            <label for="bg-type-{{ id }}">{{ trans('core.home.background_type') }}</label>
                            <select id="bg-type-{{ id }}" name="blocks[{{ id }}][settings][background_type]" data-background-toggle>
                                <option value="" {{ block.background_type == '' ? 'selected' }}>{{ trans('core.home.background_option_none') }}</option>
                                <option value="color" {{ block.background_type == 'color' ? 'selected' }}>{{ trans('core.home.background_option_color') }}</option>
                                <option value="gradient" {{ block.background_type == 'gradient' ? 'selected' }}>{{ trans('core.home.background_option_gradient') }}</option>
                                <option value="image" {{ block.background_type == 'image' ? 'selected' }}>{{ trans('core.home.background_option_image') }}</option>
                            </select>
                        </div>
                        <div class="field" data-background-field="color gradient">
                            <label for="bg-color-{{ id }}">{{ trans('core.home.background_color') }}</label>
                            <input id="bg-color-{{ id }}" type="color" name="blocks[{{ id }}][settings][background_color]" value="{{ block.background_color ?: '#ffffff' }}">
                        </div>
                        <div class="field" data-background-field="gradient">
                            <label for="bg-color2-{{ id }}">{{ trans('core.home.background_color2') }}</label>
                            <input id="bg-color2-{{ id }}" type="color" name="blocks[{{ id }}][settings][background_color2]" value="{{ block.background_color2 ?: '#ffffff' }}">
                        </div>
                        <div class="field" data-background-field="image">
                            <label for="bg-media-{{ id }}">{{ trans('core.home.picture') }}</label>
                            <select id="bg-media-{{ id }}" name="blocks[{{ id }}][settings][background_media]">
                                <option value="">{{ trans('core.home.picture_none') }}</option>
                                {% for picture in library_pictures() %}
                                    <option value="{{ picture.url }}" {{ picture.url == block.background_media ? 'selected' }}>{{ picture.title ?: picture.url }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="field" data-background-field="image">
                            <label for="bg-opacity-{{ id }}">{{ trans('core.home.background_opacity') }}</label>
                            <input id="bg-opacity-{{ id }}" type="number" min="0" max="100" name="blocks[{{ id }}][settings][background_opacity]" value="{{ block.background_opacity ?? 100 }}">
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>{{ trans('core.home.text_style') }}</legend>
                        <div class="field">
                            <label class="checkbox">
                                <input type="checkbox" name="blocks[{{ id }}][settings][text_color_enabled]" value="1" {{ block.text_color ? 'checked' }}>
                                <span>{{ trans('core.home.text_color_enable') }}</span>
                            </label>
                        </div>
                        <div class="field">
                            <label for="text-color-{{ id }}">{{ trans('core.home.text_color') }}</label>
                            <input id="text-color-{{ id }}" type="color" name="blocks[{{ id }}][settings][text_color]" value="{{ block.text_color ?: '#ffffff' }}">
                        </div>
                        <div class="field">
                            <label class="checkbox">
                                <input type="checkbox" name="blocks[{{ id }}][settings][shadow]" value="1" {{ block.shadow ? 'checked' }}>
                                <span>{{ trans('core.home.text_shadow') }}</span>
                            </label>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>{{ trans('core.home.shape') }}</legend>
                        <div class="field">
                            <label class="checkbox">
                                <input type="checkbox" name="blocks[{{ id }}][settings][shape_top]" value="1" {{ block.shape_top ? 'checked' }}>
                                <span>{{ trans('core.home.shape_top') }}</span>
                            </label>
                        </div>
                        <div class="field">
                            <label class="checkbox">
                                <input type="checkbox" name="blocks[{{ id }}][settings][shape_bottom]" value="1" {{ block.shape_bottom ? 'checked' }}>
                                <span>{{ trans('core.home.shape_bottom') }}</span>
                            </label>
                        </div>
                        <div class="field">
                            <label for="shape-color-{{ id }}">{{ trans('core.home.shape_color') }}</label>
                            <input id="shape-color-{{ id }}" type="color" name="blocks[{{ id }}][settings][shape_color]" value="{{ block.shape_color ?: '#ffffff' }}">
                        </div>
                        <div class="field">
                            <label for="shape-style-{{ id }}">{{ trans('core.home.shape_style') }}</label>
                            <select id="shape-style-{{ id }}" name="blocks[{{ id }}][settings][shape_style]">
                                {% for name in ['wave', 'curve', 'slant', 'triangle'] %}
                                    <option value="{{ name }}" {{ (block.shape_style ?: 'wave') == name ? 'selected' }}>{{ trans('core.home.shape_style.' ~ name) }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="field">
                            <label for="shape-size-{{ id }}">{{ trans('core.home.shape_size') }}</label>
                            <select id="shape-size-{{ id }}" name="blocks[{{ id }}][settings][shape_size]">
                                {% for name in ['sm', 'md', 'lg'] %}
                                    <option value="{{ name }}" {{ (block.shape_size ?: 'md') == name ? 'selected' }}>{{ trans('core.home.shape_size.' ~ name) }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="field">
                            <label for="shape-opacity-{{ id }}">{{ trans('core.home.shape_opacity') }}</label>
                            <input id="shape-opacity-{{ id }}" type="number" min="0" max="100" name="blocks[{{ id }}][settings][shape_opacity]" value="{{ block.shape_opacity ?? 100 }}">
                        </div>
                    </fieldset>
                    {% for field in fields %}
                        {% set value = block.texts[locale()][field] ?? '' %}
                        {% set name = 'blocks[' ~ id ~ '][texts][' ~ locale() ~ '][' ~ field ~ ']' %}
                        {# The built-in types share one catalogue of field labels; a type an extension
                           registered (pageBlockType()) has none there, so it gets its own, next to its
                           own label (e.g. "fields.block.list" + ".field.type_key"). #}
                        {% set field_key = field in ['title', 'text', 'button_label', 'button_url', 'heading', 'body', 'caption', 'items']
                            ? 'core.home.field.' ~ field : block.label_key ~ '.field.' ~ field %}
                        <div class="field">
                            <label for="{{ field }}-{{ id }}">{{ trans(field_key) }}</label>
                            {% if field == 'body' %}
                                <textarea id="{{ field }}-{{ id }}" name="{{ name }}" rows="8" data-editor="{{ editor() }}">{{ value }}</textarea>
                                {% if block.type == 'text' and shortcode_hints() %}<small>{{ trans('core.home.shortcodes_hint') }} {{ shortcode_hints()|join(' · ') }}</small>{% endif %}
                            {% elseif field == 'button_url' or field == 'button2_url' %}
                                <input id="{{ field }}-{{ id }}" name="{{ name }}" value="{{ value }}" maxlength="500" placeholder="/offers oder https://…">
                            {% elseif field == 'items' or field == 'text' or field == 'checklist' %}
                                <textarea id="{{ field }}-{{ id }}" name="{{ name }}" rows="3">{{ value }}</textarea>
                            {% elseif field == 'image' %}
                                <select id="{{ field }}-{{ id }}" name="{{ name }}">
                                    <option value="">{{ trans('core.home.picture_none') }}</option>
                                    {% for picture in library_pictures() %}
                                        <option value="{{ picture.url }}" {{ picture.url == value ? 'selected' }}>{{ picture.title ?: picture.url }}</option>
                                    {% endfor %}
                                </select>
                            {% else %}
                                <input id="{{ field }}-{{ id }}" name="{{ name }}" value="{{ value }}" maxlength="300">
                            {% endif %}
                        </div>
                    {% endfor %}
                    <button type="submit" name="action" value="save">{{ trans('core.account.save') }}</button>
                </form>
            </details>
        {% endif %}
    </div>

    {% if block.enabled %}
        {% include partial with block_context(block) %}
    {% else %}
        <p class="inline-off">{{ trans(label_key) }} · {{ trans('core.inline.hidden') }}</p>
    {% endif %}

    {% include '@admin/inline/_plus.twig' with {after: id, page_path: page_path, add_types: add_types, permission: permission} %}
</div>
