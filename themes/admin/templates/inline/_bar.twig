{# The bar above the blocks of an editable page: the way into editing, and the way out,
   and adding a block. Shown to administrators only. Receives page_path, add_types. #}
{% if can('core.settings.manage') %}
<div class="inline-bar" role="region" aria-label="{{ trans('core.inline.title') }}" data-saving="{{ trans('core.inline.saving') }}" data-saved="{{ trans('core.inline.saved') }}" data-failed="{{ trans('core.inline.failed') }}">
    {% if edit_mode() %}
        <p><strong>{{ trans('core.inline.editing') }}</strong> <a href="{{ url(current_path()) }}">{{ trans('core.inline.done') }}</a></p>
        <form method="post" action="{{ url(page_path) }}" class="inline-add">
            {{ csrf_field() }}
            <input type="hidden" name="return" value="{{ current_path() }}?edit=1">
            <label for="inline-add-type">{{ trans('core.home.add') }}</label>
            <select id="inline-add-type" name="add_type">
                {% for type in add_types %}
                    <option value="{{ type }}">{{ trans('core.home.type.' ~ type) }}</option>
                {% endfor %}
            </select>
            <button type="submit" name="action" value="add">{{ trans('core.home.add') }}</button>
        </form>
        {% include '@admin/inline/_plus.twig' with {after: 'start', page_path: page_path, add_types: add_types} %}
    {% else %}
        <p><a href="{{ url(current_path()) }}?edit=1">{{ trans('core.inline.start') }}</a></p>
    {% endif %}
</div>
{% endif %}
