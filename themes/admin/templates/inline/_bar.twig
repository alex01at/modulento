{# The bar above the blocks of an editable page: the way into editing, and the way out,
   and adding a block. Shown to administrators only. Receives page_path, add_types, and
   optionally permission (default core.settings.manage - home and offer pages; a content
   page passes core.pages.manage) and settings_url (a link to that page's own settings,
   shown next to "done" - the home page has none, so it omits this). #}
{% set permission = permission|default('core.settings.manage') %}
{% if can(permission) %}
<div class="inline-bar" role="region" aria-label="{{ trans('core.inline.title') }}" data-saving="{{ trans('core.inline.saving') }}" data-saved="{{ trans('core.inline.saved') }}" data-failed="{{ trans('core.inline.failed') }}" data-editor-labels="{{ editor() }}">
    {% if edit_mode(permission) %}
        <p><strong>{{ trans('core.inline.editing') }}</strong> <a href="{{ url(current_path()) }}">{{ trans('core.inline.done') }}</a>{% if settings_url is defined and settings_url %} · <a href="{{ settings_url }}">{{ trans('core.inline.page_settings') }}</a>{% endif %}</p>
        <form method="post" action="{{ url(page_path) }}" class="inline-add">
            {{ csrf_field() }}
            <input type="hidden" name="return" value="{{ current_path() }}?edit=1">
            <label for="inline-add-type">{{ trans('core.home.add') }}</label>
            <select id="inline-add-type" name="add_type">
                {% for type, label_key in add_types %}
                    <option value="{{ type }}">{{ trans(label_key) }}</option>
                {% endfor %}
            </select>
            <button type="submit" name="action" value="add">{{ trans('core.home.add') }}</button>
        </form>
        {% include '@admin/inline/_plus.twig' with {after: 'start', page_path: page_path, add_types: add_types, permission: permission} %}
    {% else %}
        <p><a href="{{ url(current_path()) }}?edit=1">{{ trans('core.inline.start') }}</a></p>
    {% endif %}
</div>
{% endif %}
