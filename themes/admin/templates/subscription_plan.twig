{% extends '@admin/layout.twig' %}

{% block title %}{{ plan.name }} – {{ trans('core.admin.subscriptions.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: plan.name, crumbs: [{label: trans('core.admin.subscriptions.title'), path: '/admin/subscriptions'}]} only %}

<div class="split">
<section class="card-box">
    <div class="card-head">
        <p>{{ trans('core.admin.subscriptions.plan.intro') }}</p>
        <p><small>{{ trans('core.admin.subscriptions.plans.form.slug') }}: <code>{{ plan.slug }}</code></small></p>
    </div>
    <form method="post" action="{{ url('/admin/subscriptions/plans/' ~ plan.id) }}" class="stack-form" id="plan-form">
        {{ csrf_field() }}
        <label for="plan-name">{{ trans('core.admin.subscriptions.plans.form.name') }}</label>
        <input id="plan-name" name="name" value="{{ plan.name }}" maxlength="100" required>
        <label for="plan-price">{{ trans('core.admin.subscriptions.plans.form.price') }}</label>
        <input id="plan-price" name="price" value="{{ price }}" inputmode="decimal" required>
        <label for="plan-currency">{{ trans('core.admin.subscriptions.plans.form.currency') }}</label>
        <input id="plan-currency" name="currency" value="{{ plan.currency }}" maxlength="3" pattern="[A-Za-z]{3}" required>
        <label for="plan-period">{{ trans('core.admin.subscriptions.plans.form.period') }}</label>
        <select id="plan-period" name="period_months">
            {% for months in periods %}
                <option value="{{ months }}" data-label="{{ trans(months == 1 ? 'core.admin.subscriptions.plans.months_one' : 'core.admin.subscriptions.plans.months', {count: months}) }}" {{ months == plan.period_months ? 'selected' }}>{{ trans(months == 1 ? 'core.admin.subscriptions.plans.months_one' : 'core.admin.subscriptions.plans.months', {count: months}) }}</option>
            {% endfor %}
        </select>

        <fieldset>
            <legend>{{ trans('core.admin.subscriptions.plan.features') }}</legend>
            {% if features is empty %}
                <p><small>{{ trans('core.admin.subscriptions.plan.no_features') }}</small></p>
            {% endif %}
            {% for feature in features %}
                <label class="checkbox">
                    <input type="checkbox" name="features[]" value="{{ feature.key }}" data-label="{{ feature.label_key ? trans(feature.label_key) : feature.key }}" {{ feature.key in plan.features ? 'checked' }}>
                    <span>{% if feature.label_key %}{{ trans(feature.label_key) }} <small>{{ feature.key }}</small>{% else %}{{ feature.key }}{% endif %}</span>
                </label>
            {% endfor %}
            <label for="plan-new-features">{{ trans('core.admin.subscriptions.plan.new_features') }}</label>
            <input id="plan-new-features" name="new_features" placeholder="visitenkarte.logo">
            <small>{{ trans('core.admin.subscriptions.plan.new_features_hint') }}</small>
        </fieldset>

        <fieldset>
            <legend>{{ trans('core.admin.subscriptions.plan.limits') }}</legend>
            <p><small>{{ trans('core.admin.subscriptions.plan.limits_hint') }}</small></p>
            {% for type in offer_types %}
                <label for="plan-limit-{{ type.id }}">{{ trans(type.label_key) }}</label>
                <input id="plan-limit-{{ type.id }}" name="offer_limits[{{ type.id }}]" type="number" min="0" data-label="{{ trans(type.label_key) }}" value="{{ plan.offer_limits[type.id] ?? '' }}">
            {% endfor %}
            <label for="plan-max-images">{{ trans('core.admin.subscriptions.plan.max_images') }}</label>
            <input id="plan-max-images" name="max_images_per_offer" type="number" min="0" value="{{ plan.max_images_per_offer ?? '' }}">
        </fieldset>

        <label class="checkbox">
            <input type="checkbox" name="active" value="1" {{ plan.active ? 'checked' }}>
            <span>{{ trans('core.admin.subscriptions.plan.active') }}</span>
        </label>
        <small>{{ trans('core.admin.subscriptions.plan.active_hint') }}</small>
        <button type="submit">{{ trans('core.admin.subscriptions.plan.save') }}</button>
    </form>
</section>

<aside class="card-box plan-preview" aria-live="polite">
    <div class="card-head">
        <h2>{{ trans('core.admin.subscriptions.plan.preview') }}</h2>
    </div>
    <p><small>{{ trans('core.admin.subscriptions.plan.preview_hint') }}</small></p>
    <div class="plan-card">
        <div class="card-head">
            <strong class="card-title" id="preview-name" data-placeholder="{{ trans('core.admin.subscriptions.plan.preview_unnamed') }}"></strong>
            <span class="badge" id="preview-badge" data-active="{{ trans('core.admin.subscriptions.plans.active_badge') }}" data-inactive="{{ trans('core.admin.subscriptions.plans.inactive') }}"></span>
        </div>
        <p class="price" id="preview-price"></p>
        <ul id="preview-features" class="plan-preview-list" data-none-label="{{ trans('core.admin.subscriptions.plan.preview_empty') }}" data-images-label="{{ trans('core.admin.subscriptions.plan.preview_images') }}"></ul>
    </div>
</aside>
</div>

<section class="card-box">
    <h2>{{ trans('core.admin.subscriptions.plan.delete.title') }}</h2>
    <p>{{ trans('core.admin.subscriptions.plan.delete.intro') }}</p>
    <form method="post" action="{{ url('/admin/subscriptions/plans/' ~ plan.id ~ '/delete') }}">
        {{ csrf_field() }}
        <button type="submit" class="danger">{{ trans('core.admin.subscriptions.plan.delete.submit') }}</button>
    </form>
</section>
{% endblock %}
