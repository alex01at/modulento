{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.admin.roles.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {
    heading: role and role.id ? trans('core.admin.roles.edit') : trans('core.admin.roles.new'),
    crumbs: [{label: trans('core.admin.roles.title'), path: '/admin/roles'}]
} only %}

{% if error %}
    <p class="flash flash-error" role="alert">{{ error }}</p>
{% endif %}

{% if presets %}
    <section class="card-box">
        <p>{{ trans('core.admin.roles.presets_intro') }}</p>
        <div class="button-row">
            {% for preset in presets %}
                <a class="btn btn-outline btn-sm" href="{{ url('/admin/roles/new') }}?preset={{ preset }}">{{ trans('core.admin.roles.preset.' ~ preset) }}</a>
            {% endfor %}
        </div>
    </section>
{% endif %}

<form method="post" action="{{ url(role and role.id ? '/admin/roles/' ~ role.id : '/admin/roles/new') }}">
    {{ csrf_field() }}
    <div class="card-box stack-form">
        <div class="field">
            <label for="name">{{ trans('core.admin.extensions.name') }}</label>
            <input id="name" name="name" value="{{ role ? role.name : '' }}" maxlength="64" required>
        </div>
    </div>

    {# Grouped like the menu: what a permission opens is where it is listed. #}
    {% for group in groups %}
        <fieldset class="card-box">
            <legend>{{ trans(group.label_key) }}</legend>
            <div class="check-list">
                {% for permission in group.permissions %}
                    <label class="checkbox">
                        <input type="checkbox" name="permissions[]" value="{{ permission.name }}" {{ role and permission.name in role.permissions ? 'checked' }}>
                        <span>
                            <strong>{{ trans(permission.label_key) }}</strong>
                            {% if permission.hint %}<br><small>{{ permission.hint }}</small>{% endif %}
                            <br><small class="muted">{{ permission.name }}</small>
                        </span>
                    </label>
                {% endfor %}
            </div>
        </fieldset>
    {% endfor %}

    <div class="card-box button-row">
        <button type="submit">{{ trans('core.account.save') }}</button>
    </div>
</form>

{% if role and role.id %}
    <section class="card-box">
        <form method="post" action="{{ url('/admin/roles/' ~ role.id ~ '/delete') }}" class="danger-form">
            {{ csrf_field() }}
            <button type="submit" class="danger">{{ trans('core.admin.roles.delete') }}</button>
        </form>
    </section>
{% endif %}
{% endblock %}
