{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.admin.roles.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
<p><a href="{{ url('/admin/roles') }}">{{ trans('core.admin.roles.title') }}</a></p>
<h1>{{ role and role.id ? trans('core.admin.roles.edit') : trans('core.admin.roles.new') }}</h1>

{% if error %}
    <p class="flash flash-error" role="alert">{{ error }}</p>
{% endif %}

<form method="post" action="{{ url(role and role.id ? '/admin/roles/' ~ role.id : '/admin/roles/new') }}" class="stack-form wide">
    {{ csrf_field() }}
    <label for="name">{{ trans('core.admin.extensions.name') }}</label>
    <input id="name" name="name" value="{{ role ? role.name : '' }}" maxlength="64" required>

    <fieldset>
        <legend>{{ trans('core.admin.roles.permissions') }}</legend>
        {% for name, label_key in permissions %}
            <label class="checkbox">
                <input type="checkbox" name="permissions[]" value="{{ name }}" {{ role and name in role.permissions ? 'checked' }}>
                <span>{{ trans(label_key) }} <small>({{ name }})</small></span>
            </label>
        {% endfor %}
    </fieldset>

    <button type="submit">{{ trans('core.account.save') }}</button>
</form>

{% if role and role.id %}
    <form method="post" action="{{ url('/admin/roles/' ~ role.id ~ '/delete') }}">
        {{ csrf_field() }}
        <button type="submit" class="danger">{{ trans('core.admin.roles.delete') }}</button>
    </form>
{% endif %}
{% endblock %}
