{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.update.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: trans('core.update.title')} only %}

<section class="card-box">
    <p>
        {{ trans('core.update.current_version') }}:
        <span class="badge">{{ current_version == '0.0.0' ? trans('core.update.version_unreleased') : current_version }}</span>
    </p>

    {% if not enabled %}
        <p>{{ trans('core.update.error.disabled') }}</p>
    {% elseif dev_checkout %}
        <p>{{ trans('core.update.error.dev_checkout') }}</p>
    {% else %}
        {% if stale_lock %}
            <p class="flash flash-error">
                {{ trans('core.update.stale_lock', {stage: stale_lock.stage, version: stale_lock.release_version, started_at: stale_lock.started_at}) }}
            </p>
        {% endif %}

        {% if available %}
            <h2>{{ trans('core.update.available', {version: available.version}) }}</h2>
            {% if available.changelog %}
                <pre class="changelog">{{ available.changelog }}</pre>
            {% endif %}
            <p>{{ trans('core.update.apply_hint') }}</p>
            <form method="post" action="{{ url('/admin/updates/apply') }}">
                {{ csrf_field() }}
                <button type="submit">{{ trans('core.update.apply', {version: available.version}) }}</button>
            </form>
        {% else %}
            <form method="post" action="{{ url('/admin/updates/check') }}">
                {{ csrf_field() }}
                <button type="submit">{{ trans('core.update.check') }}</button>
            </form>
        {% endif %}
    {% endif %}
</section>

<section class="card-box">
    <h2>{{ trans('core.update.migrations_title') }}</h2>
    <p>{{ trans('core.update.migrations_hint') }}</p>
    <form method="post" action="{{ url('/admin/updates/migrate') }}">
        {{ csrf_field() }}
        <button type="submit" class="btn-outline">{{ trans('core.update.migrations_run') }}</button>
    </form>
</section>
{% endblock %}
