{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.update.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: trans('core.update.title')} only %}

<section class="card-box">
    <h2>{{ trans('core.update.components_title') }}</h2>
    <p>{{ trans('core.update.components_hint') }}</p>
    {% if not enabled %}
        <p>{{ trans('core.update.error.disabled') }}</p>
    {% elseif dev_checkout %}
        <p>{{ trans('core.update.error.dev_checkout') }}</p>
    {% endif %}
    {% if stale_lock %}
        <p class="flash flash-error">
            {{ trans('core.update.stale_lock', {stage: stale_lock.stage, version: stale_lock.release_version, started_at: stale_lock.started_at}) }}
        </p>
    {% endif %}

    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th scope="col">{{ trans('core.update.col_component') }}</th>
                <th scope="col">{{ trans('core.update.col_installed') }}</th>
                <th scope="col">{{ trans('core.update.col_latest') }}</th>
                <th scope="col"><span class="visually-hidden">{{ trans('core.update.col_action') }}</span></th>
            </tr>
            </thead>
            <tbody>
            {% for component in components %}
                {% set core = component.kind == 'core' %}
                <tr>
                    <th scope="row">
                        {{ core ? trans('core.update.core') : component.id }}
                        <small>{{ trans('core.package.kind.' ~ component.kind) }}</small>
                    </th>
                    <td>{{ core and component.installed == '0.0.0' ? trans('core.update.version_unreleased') : component.installed }}</td>
                    <td>
                        {% if component.latest %}
                            {{ component.latest }}
                            {% if component.newer %}<span class="badge badge-pending">{{ trans('core.update.newer') }}</span>{% endif %}
                        {% else %}
                            <small>{{ trans('core.update.unknown') }}</small>
                        {% endif %}
                    </td>
                    <td>
                        {% if component.newer and (core ? (enabled and not dev_checkout) : can_packages) %}
                            <form method="post" action="{{ url(component.action) }}" class="inline-form">
                                {{ csrf_field() }}
                                <button type="submit" class="btn-sm">{{ trans('core.update.apply', {version: component.latest}) }}</button>
                            </form>
                        {% elseif not core and not can_packages %}
                            <small>{{ trans('core.update.packages_need_permission') }}</small>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <p><small>{{ checked_at ? trans('core.update.checked_at', {date: checked_at}) : trans('core.update.never_checked') }}</small></p>
    {% if enabled and not dev_checkout %}
        <form method="post" action="{{ url('/admin/updates/check') }}">
            {{ csrf_field() }}
            <button type="submit">{{ trans('core.update.check') }}</button>
        </form>
    {% endif %}
</section>

<section class="card-box">
    <h2>{{ trans('core.update.migrations_title') }}</h2>
    <p>{{ trans('core.update.migrations_hint') }}</p>
    <form method="post" action="{{ url('/admin/updates/migrate') }}">
        {{ csrf_field() }}
        <button type="submit" class="btn-outline">{{ trans('core.update.migrations_run') }}</button>
    </form>
</section>

{% endblock %}
