{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.admin.extensions.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: trans('core.admin.extensions.title')} only %}

<section class="card-box">
<p>{{ trans('core.admin.extensions.single') }}</p>
<p>{{ trans('core.admin.extensions.type_explain') }}</p>
{% if extensions is empty %}
    <p class="empty">{{ trans('core.admin.extensions.none') }}</p>
{% else %}
    <div class="filter-bar" role="group" aria-label="{{ trans('core.admin.extensions.filter') }}" data-extensions-filter>
        <button type="button" data-filter="all" aria-pressed="true">{{ trans('core.admin.extensions.filter_all') }}</button>
        <button type="button" data-filter="app" aria-pressed="false">{{ trans('core.admin.extensions.filter_app') }}</button>
        <button type="button" data-filter="addon" aria-pressed="false">{{ trans('core.admin.extensions.filter_addon') }}</button>
    </div>
    <div class="columns" data-extensions-grid
         data-label-enabled="{{ trans('core.admin.extensions.status_enabled') }}"
         data-label-disabled="{{ trans('core.admin.extensions.status_disabled') }}"
         data-label-failed="{{ trans('core.admin.extensions.toggle_failed') }}">
        {% for extension in extensions %}
            <div class="card-box ext-tile" data-extension-id="{{ extension.id }}" data-extension-type="{{ extension.type }}">
                <div class="ext-tile-head">
                    <div>
                        <h3>{{ extension.name }}</h3>
                        <p class="ext-id">{{ extension.id }} · v{{ extension.version }}</p>
                    </div>
                    <form method="post" class="ext-toggle-form"
                          action="{{ url('/admin/extensions/' ~ extension.id ~ (extension.enabled ? '/disable' : '/enable')) }}"
                          data-enable-url="{{ url('/admin/extensions/' ~ extension.id ~ '/enable') }}"
                          data-disable-url="{{ url('/admin/extensions/' ~ extension.id ~ '/disable') }}">
                        {{ csrf_field() }}
                        <button type="submit" class="toggle{{ extension.enabled ? ' is-on' }}"
                                aria-pressed="{{ extension.enabled ? 'true' : 'false' }}"
                                aria-label="{{ extension.name }}"
                                {{ not extension.compatible ? 'disabled' }}></button>
                    </form>
                </div>
                <div class="ext-badges">
                    <span class="badge">{{ trans('core.admin.extensions.type_' ~ extension.type) }}</span>
                    {% if not extension.compatible %}
                        <span class="badge badge-incompatible" data-status-badge>{{ trans('core.admin.extensions.status_incompatible', {needed: extension.api, provided: api_version}) }}</span>
                    {% else %}
                        <span class="badge {{ extension.enabled ? 'badge-enabled' : 'badge-disabled' }}" data-status-badge>{{ extension.enabled ? trans('core.admin.extensions.status_enabled') : trans('core.admin.extensions.status_disabled') }}</span>
                    {% endif %}
                </div>
                {% if extension.description %}<p class="ext-description">{{ extension.description }}</p>{% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}
</section>

{% if invalid is not empty %}
    <section class="card-box">
        <h2>{{ trans('core.admin.extensions.invalid_title') }}</h2>
        <ul>
            {% for folder, reason in invalid %}
                <li><strong>{{ folder }}</strong>: {{ reason }}</li>
            {% endfor %}
        </ul>
    </section>
{% endif %}

{% if missing is not empty %}
    <section class="card-box">
        <h2>{{ trans('core.admin.extensions.missing_title') }}</h2>
        <ul>
            {% for id in missing %}
                <li>{{ id }}</li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
{% endblock %}
