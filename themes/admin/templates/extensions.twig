{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('core.admin.extensions.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: trans('core.admin.extensions.title')} only %}

<section class="card-box">
<p>{{ trans('core.admin.extensions.single') }}</p>
{% if extensions is empty %}
    <p class="empty">{{ trans('core.admin.extensions.none') }}</p>
{% else %}
    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th scope="col">{{ trans('core.admin.extensions.name') }}</th>
                <th scope="col">{{ trans('core.admin.extensions.version') }}</th>
                <th scope="col">{{ trans('core.admin.extensions.status') }}</th>
                <th scope="col"></th>
            </tr>
            </thead>
            <tbody>
            {% for extension in extensions %}
                <tr>
                    <th scope="row">{{ extension.name }} <small>({{ extension.id }})</small></th>
                    <td>{{ extension.version }}</td>
                    <td>
                        {% if not extension.compatible %}
                            <span class="badge badge-incompatible">{{ trans('core.admin.extensions.status_incompatible', {needed: extension.api, provided: api_version}) }}</span>
                        {% elseif extension.enabled %}
                            <span class="badge badge-enabled">{{ trans('core.admin.extensions.status_enabled') }}</span>
                        {% else %}
                            <span class="badge badge-disabled">{{ trans('core.admin.extensions.status_disabled') }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if extension.enabled %}
                            <form method="post" action="{{ url('/admin/extensions/' ~ extension.id ~ '/disable') }}">
                                {{ csrf_field() }}
                                <button type="submit" class="btn-outline btn-sm">{{ trans('core.admin.extensions.disable') }}</button>
                            </form>
                        {% elseif extension.compatible %}
                            <form method="post" action="{{ url('/admin/extensions/' ~ extension.id ~ '/enable') }}">
                                {{ csrf_field() }}
                                <button type="submit" class="btn-sm">{{ trans('core.admin.extensions.enable') }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
</section>

{% if invalid is not empty %}
    <section class="card-box">
        <h2>{{ trans('core.admin.extensions.invalid_title') }}</h2>
        <ul>
            {% for folder, reason in invalid %}
                <li><strong>{{ folder }}</strong>: {{ reason }}</li>
            {% endfor %}
        </ul>
    </section>
{% endif %}

{% if missing is not empty %}
    <section class="card-box">
        <h2>{{ trans('core.admin.extensions.missing_title') }}</h2>
        <ul>
            {% for id in missing %}
                <li>{{ id }}</li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
{% endblock %}
