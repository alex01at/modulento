{% extends 'layout/base.twig' %}

{% block title %}{{ trans('core.providers.title') }} – {{ site_name }}{% endblock %}

{% block content %}
<h1>{{ trans('core.providers.title') }}</h1>

{% if providers is empty %}
    <p>{{ trans('core.providers.none') }}</p>
{% else %}
    {% include 'provider/_cards.twig' %}

    {% if pages > 1 %}
        <nav class="pager" aria-label="{{ trans('core.pager.label') }}">
            {% if page > 1 %}<a href="{{ url('/providers') }}?page={{ page - 1 }}" rel="prev">{{ trans('core.pager.previous') }}</a>{% endif %}
            <span>{{ trans('core.pager.position', {page: page, pages: pages}) }}</span>
            {% if page < pages %}<a href="{{ url('/providers') }}?page={{ page + 1 }}" rel="next">{{ trans('core.pager.next') }}</a>{% endif %}
        </nav>
    {% endif %}
{% endif %}
{% endblock %}
