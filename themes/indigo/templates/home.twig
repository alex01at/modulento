{% extends 'layout/base.twig' %}
{% import '_icons.twig' as icons %}

{% block page %}
{% set tree = categories() %}

<section class="hero">
    <div class="container narrow">
        <p class="badge"><span class="dot"></span>{{ trans('theme.hero.badge') }}</p>
        <h1>{{ trans('theme.hero.title') }} <span class="accent">{{ trans('theme.hero.title_accent') }}</span></h1>
        <p class="lead">{{ trans('theme.hero.lead') }}</p>

        <form method="get" action="{{ url('/offers') }}" class="search-box" role="search">
            <label class="visually-hidden" for="hero-q">{{ trans('core.offers.search') }}</label>
            <div class="search-field">
                {{ icons.icon('search') }}
                <input id="hero-q" name="q" type="search" placeholder="{{ trans('theme.hero.search_placeholder') }}">
            </div>
            {% if tree %}
                <label class="visually-hidden" for="hero-category">{{ trans('core.offers.categories') }}</label>
                <select id="hero-category" name="category">
                    <option value="">{{ trans('theme.hero.all_categories') }}</option>
                    {% for top in tree %}
                        <option value="{{ top.id }}">{{ top.name }}</option>
                    {% endfor %}
                </select>
            {% endif %}
            <button type="submit">{{ trans('theme.hero.search_submit') }}</button>
        </form>

        <ul class="trust">
            {% for key in ['theme.trust.providers', 'theme.trust.reviews', 'theme.trust.packages'] %}
                <li>{{ icons.icon('check') }} {{ trans(key) }}</li>
            {% endfor %}
        </ul>
    </div>
</section>

{% if tree %}
    <section class="band band-white">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow">{{ trans('core.offers.categories') }}</p>
                    <h2>{{ trans('theme.categories.title') }}</h2>
                </div>
                <a class="more" href="{{ url('/offers') }}">{{ trans('core.offers.all') }} {{ icons.icon('arrow') }}</a>
            </div>
            <ul class="category-grid">
                {% for top in tree|slice(0, 8) %}
                    <li>
                        <a href="{{ url(top.path) }}">
                            <span class="category-mark tone-{{ loop.index0 % 4 + 1 }}" aria-hidden="true">{{ top.name|first|upper }}</span>
                            <strong>{{ top.name }}</strong>
                            {% if top.children %}
                                <span class="muted">{{ top.children|map(child => child.name)|slice(0, 4)|join(', ') }}</span>
                            {% endif %}
                            <small>{{ trans(top.offer_count == 1 ? 'core.offers.total_one' : 'core.offers.total', {count: top.offer_count}) }}</small>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endif %}

{% set offers = latest_offers(6) %}
{% if offers %}
    <section class="band">
        <div class="container">
            <div class="section-head centered">
                <p class="eyebrow">{{ trans('theme.offers.eyebrow') }}</p>
                <h2>{{ trans('core.offers.latest') }}</h2>
            </div>
            {% include 'offer/_cards.twig' %}
        </div>
    </section>
{% endif %}

{% set providers = top_providers(3) %}
{% if providers %}
    <section class="band band-white">
        <div class="container">
            <div class="section-head centered">
                <p class="eyebrow">{{ trans('core.nav.providers') }}</p>
                <h2>{{ trans('theme.providers.title') }}</h2>
                <p class="muted">{{ trans('theme.providers.lead') }}</p>
            </div>
            {% include 'provider/_cards.twig' %}
        </div>
    </section>
{% endif %}

<section class="band">
    <div class="container">
        <div class="section-head centered">
            <p class="eyebrow">{{ trans('theme.steps.eyebrow') }}</p>
            <h2>{{ trans('theme.steps.title') }}</h2>
        </div>
        <ol class="steps">
            {% for number in 1..3 %}
                <li>
                    <span class="step-number" aria-hidden="true">{{ number }}</span>
                    <h3>{{ trans('theme.steps.' ~ number ~ '.title') }}</h3>
                    <p>{{ trans('theme.steps.' ~ number ~ '.text') }}</p>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>

<section class="cta">
    <div class="container narrow">
        <h2>{{ trans('theme.cta.title') }}</h2>
        <p>{{ trans('theme.cta.lead') }}</p>
        <div class="cta-actions">
            {% if account %}
                <a class="button large" href="{{ url('/account/provider') }}">{{ trans('theme.cta.primary') }}</a>
            {% elseif registration_open() %}
                <a class="button large" href="{{ url('/register') }}">{{ trans('theme.cta.primary') }}</a>
            {% endif %}
            <a class="button large ghost" href="{{ url('/providers') }}">{{ trans('theme.cta.secondary') }}</a>
        </div>
    </div>
</section>
{% endblock %}
