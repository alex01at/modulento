{# A list of offer cards. Receives "offers". #}
{% import '_icons.twig' as icons %}
<ul class="card-list offer-cards">
    {% for offer in offers %}
        <li>
            <a class="card-image" href="{{ url(offer.path) }}" tabindex="-1" aria-hidden="true">
                {% if offer.thumb %}
                    <img src="{{ offer.thumb }}" alt="" loading="lazy">
                {% else %}
                    <span class="card-image-empty">{{ icons.icon('image') }}</span>
                {% endif %}
            </a>
            <div class="card-body">
                <a class="card-title" href="{{ url(offer.path) }}">{{ offer.title }}</a>
                {% if offer.summary %}<p>{{ offer.summary }}</p>{% endif %}
                {% include 'review/_rating.twig' with {rating: offer.rating} only %}
            </div>
            <div class="card-foot">
                <a href="{{ url(offer.provider_path) }}">{{ offer.provider_name }}</a>
                {% if offer.price_from is not null %}
                    <strong>{{ trans('core.offer.price_from', {price: money(offer.price_from, offer.currency)}) }}</strong>
                {% endif %}
            </div>
        </li>
    {% endfor %}
</ul>
