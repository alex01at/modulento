{% extends 'layout/base.twig' %}

{% block title %}{{ trans('core.subscriptions.title') }} – {{ site_name }}{% endblock %}

{% block content %}
<h1>{{ trans('core.subscriptions.title') }}</h1>
<p class="lead">{{ trans('core.subscriptions.intro') }}</p>

{% if plans %}
    <ul class="card-list">
        {% for plan in plans %}
            <li>
                <strong class="card-title">{{ plan.name }}</strong>
                <span class="price">{{ money(plan.price_cents, plan.currency) }}</span>
                <small>{{ trans(plan.period_months == 1 ? 'core.subscriptions.period_one' : 'core.subscriptions.period', {count: plan.period_months}) }}</small>
                {% if plan.feature_labels %}
                    <p class="muted">{{ plan.feature_labels|join(', ') }}</p>
                {% endif %}
                {% if signed_in and (methods.transfer or methods.stripe) %}
                    <form method="post" action="{{ url('/subscriptions/' ~ plan.id ~ '/order') }}" class="button-row">
                        {{ csrf_field() }}
                        {% if methods.transfer %}<button type="submit" name="method" value="transfer" class="button">{{ trans('core.subscriptions.buy.transfer') }}</button>{% endif %}
                        {% if methods.stripe %}<button type="submit" name="method" value="stripe" class="button">{{ trans('core.subscriptions.buy.stripe') }}</button>{% endif %}
                    </form>
                {% elseif not signed_in and (methods.transfer or methods.stripe) %}
                    <p><a href="{{ url('/login') }}">{{ trans('core.subscriptions.buy.login') }}</a></p>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p>{{ trans('core.subscriptions.none') }}</p>
{% endif %}
{% endblock %}
