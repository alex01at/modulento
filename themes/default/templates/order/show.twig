{% extends 'layout/base.twig' %}

{% block title %}{{ trans('core.order.title', {number: order.number}) }} – {{ site_name }}{% endblock %}

{% block content %}
<p><a href="{{ url(role == 'buyer' ? '/account/orders' : '/account/sales') }}">{{ trans('core.order.list.' ~ role) }}</a></p>
<h1>{{ trans('core.order.title', {number: order.number}) }}</h1>
<p><strong>{{ order.title }}</strong></p>

<p class="flash {{ order.final ? '' : 'flash-success' }}">
    {{ trans(order.state_label_key) }}
    {% if order.due_at %}<br><small>{{ trans('core.order.due', {date: order.due_at}) }}</small>{% endif %}
</p>

{% if actions %}
    <section>
        <h2>{{ trans('core.order.actions') }}</h2>
        {% for name, action in actions %}
            <form method="post" action="{{ url('/orders/' ~ order.id ~ '/transition') }}" class="stack-form wide" {{ action.files ? 'enctype="multipart/form-data"' }}>
                {{ csrf_field() }}
                <input type="hidden" name="transition" value="{{ name }}">
                {% if action.note %}
                    <label for="note_{{ name }}">{{ trans(action.note == 'required' ? 'core.order.note_required' : 'core.order.note_optional') }}</label>
                    <textarea id="note_{{ name }}" name="note" rows="3" maxlength="5000" {{ action.note == 'required' ? 'required' }}></textarea>
                {% endif %}
                {% if action.files %}
                    <label for="files_{{ name }}">{{ trans('core.order.file.attach') }}</label>
                    <input id="files_{{ name }}" name="files[]" type="file" multiple>
                    <small>{{ trans('core.order.file.hint', file_limits) }}</small>
                {% endif %}
                <button type="submit">{{ trans(action.label) }}</button>
            </form>
        {% endfor %}
    </section>
{% endif %}

{% if can_review and module('reviews') %}
    <section>
        <h2>{{ trans('core.review.write') }}</h2>
        <form method="post" action="{{ url('/orders/' ~ order.id ~ '/review') }}" class="stack-form wide">
            {{ csrf_field() }}
            <fieldset>
                <legend>{{ trans('core.review.rating') }}</legend>
                {% for stars in 5..1 %}
                    <label class="checkbox">
                        <input type="radio" name="rating" value="{{ stars }}" required>
                        <span><span aria-hidden="true">{% for i in 1..5 %}{{ i <= stars ? '★' : '☆' }}{% endfor %}</span> {{ trans('core.review.stars', {rating: stars}) }}</span>
                    </label>
                {% endfor %}
            </fieldset>
            <label for="review_body">{{ trans('core.review.body') }}</label>
            <textarea id="review_body" name="body" rows="5" maxlength="2000"></textarea>
            <small>{{ trans('core.review.public_hint') }}</small>
            <button type="submit">{{ trans('core.review.submit') }}</button>
        </form>
    </section>
{% elseif review and module('reviews') %}
    <section>
        <h2>{{ trans('core.review.one') }}</h2>
        {% if review.status == 'hidden' %}
            <p class="flash flash-error">{{ trans('core.review.hidden_notice') }}</p>
        {% endif %}
        <p>
            <span role="img" aria-label="{{ trans('core.review.stars', {rating: review.rating}) }}"><span aria-hidden="true">{% for i in 1..5 %}{{ i <= review.rating ? '★' : '☆' }}{% endfor %}</span></span>
            <small>{{ review.created_at }} UTC</small>
        </p>
        {% if review.body %}<p>{{ review.body|nl2br }}</p>{% endif %}
        {% if review.reply %}
            <p class="reply"><small>{{ trans('core.review.reply_by_provider') }}</small><br>{{ review.reply|nl2br }}</p>
        {% elseif can_reply %}
            <form method="post" action="{{ url('/orders/' ~ order.id ~ '/review/reply') }}" class="stack-form wide">
                {{ csrf_field() }}
                <label for="review_reply">{{ trans('core.review.reply') }}</label>
                <textarea id="review_reply" name="reply" rows="4" maxlength="2000" required></textarea>
                <small>{{ trans('core.review.reply_hint') }}</small>
                <button type="submit">{{ trans('core.review.reply_submit') }}</button>
            </form>
        {% endif %}
    </section>
{% endif %}

{# A direct rating of the account on the other side - separate from the order review above. #}
{% if can_rate_account and module('reviews') %}
    <section>
        <h2>{{ trans('core.account_rating.write') }}</h2>
        <form method="post" action="{{ url('/accounts/' ~ account_rating_target ~ '/rating') }}" class="stack-form wide">
            {{ csrf_field() }}
            <input type="hidden" name="return" value="{{ current_path() }}">
            <fieldset>
                <legend>{{ trans('core.account_rating.rating') }}</legend>
                {% for stars in 5..1 %}
                    <label class="checkbox">
                        <input type="radio" name="rating" value="{{ stars }}" required>
                        <span><span aria-hidden="true">{% for i in 1..5 %}{{ i <= stars ? '★' : '☆' }}{% endfor %}</span> {{ trans('core.account_rating.stars', {rating: stars}) }}</span>
                    </label>
                {% endfor %}
            </fieldset>
            <label for="account_rating_body">{{ trans('core.account_rating.body') }}</label>
            <textarea id="account_rating_body" name="body" rows="5" maxlength="2000"></textarea>
            <small>{{ trans('core.account_rating.public_hint') }}</small>
            <button type="submit">{{ trans('core.account_rating.submit') }}</button>
        </form>
    </section>
{% elseif my_account_rating and module('reviews') %}
    <section>
        <h2>{{ trans('core.account_rating.one') }}</h2>
        <p>
            <span role="img" aria-label="{{ trans('core.account_rating.stars', {rating: my_account_rating.rating}) }}"><span aria-hidden="true">{% for i in 1..5 %}{{ i <= my_account_rating.rating ? '★' : '☆' }}{% endfor %}</span></span>
            <small>{{ my_account_rating.created_at }} UTC</small>
        </p>
        {% if my_account_rating.body %}<p>{{ my_account_rating.body|nl2br }}</p>{% endif %}
        {% if my_account_rating.reply %}
            <p class="reply"><small>{{ trans('core.account_rating.reply_by_rated') }}</small><br>{{ my_account_rating.reply|nl2br }}</p>
        {% endif %}
    </section>
{% endif %}

{% if their_account_rating and module('reviews') %}
    <section>
        <h2>{{ trans('core.account_rating.received') }}</h2>
        {% if their_account_rating.status == 'hidden' %}
            <p class="flash flash-error">{{ trans('core.account_rating.hidden_notice') }}</p>
        {% endif %}
        <p>
            <span role="img" aria-label="{{ trans('core.account_rating.stars', {rating: their_account_rating.rating}) }}"><span aria-hidden="true">{% for i in 1..5 %}{{ i <= their_account_rating.rating ? '★' : '☆' }}{% endfor %}</span></span>
            <small>{{ their_account_rating.created_at }} UTC</small>
        </p>
        {% if their_account_rating.body %}<p>{{ their_account_rating.body|nl2br }}</p>{% endif %}
        {% if their_account_rating.reply %}
            <p class="reply"><small>{{ trans('core.account_rating.reply_by_rated') }}</small><br>{{ their_account_rating.reply|nl2br }}</p>
        {% elseif can_reply_account %}
            <form method="post" action="{{ url('/account-ratings/' ~ their_account_rating.id ~ '/reply') }}" class="stack-form wide">
                {{ csrf_field() }}
                <input type="hidden" name="return" value="{{ current_path() }}">
                <label for="account_rating_reply">{{ trans('core.account_rating.reply') }}</label>
                <textarea id="account_rating_reply" name="reply" rows="4" maxlength="2000" required></textarea>
                <small>{{ trans('core.account_rating.reply_hint') }}</small>
                <button type="submit">{{ trans('core.account_rating.reply_submit') }}</button>
            </form>
        {% endif %}
    </section>
{% endif %}

<section>
    <h2>{{ trans('core.order.details') }}</h2>
    <table>
        {% for item in order.items %}
            <tr>
                <td>{{ item.quantity > 1 ? item.quantity ~ ' × ' }}{{ item.label }}</td>
                <td>{{ money(item.quantity * item.unit_price, order.currency) }}</td>
            </tr>
        {% endfor %}
        <tr>
            <th scope="row">{{ trans('core.order.total') }}</th>
            <td><strong>{{ money(order.total, order.currency) }}</strong></td>
        </tr>
    </table>

    {# What the offer's type knows about this order, supplied by its extension. #}
    {% if flow_template %}
        {% include flow_template %}
    {% endif %}

    <p>
        {{ trans(role == 'buyer' ? 'core.provider.field.name' : 'core.order.buyer') }}:
        {% if counterpart.path %}<a href="{{ url(counterpart.path) }}">{{ counterpart.name }}</a>{% else %}{{ counterpart.name }}{% endif %}
        {% if counterpart.email %}· <a href="mailto:{{ counterpart.email }}">{{ counterpart.email }}</a>{% endif %}
    </p>
    {% if role == 'buyer' and module('withdrawal') %}
        {# Keep this link in every theme: the withdrawal form has to be easy to find. #}
        <p><small><a href="{{ url('/withdrawal') }}?order={{ order.number }}">{{ trans('core.withdrawal.link') }}</a></small></p>
    {% endif %}
</section>

<section id="payment">
    <h2>{{ trans('core.order.payment') }}</h2>
    {% if payment.needs_choice %}
        {# The order has no way to pay that its provider offers: the buyer chooses one below. #}
        <p class="flash flash-error">{{ trans(payment.choices ? 'core.payment.choose' : 'core.payment.none_available') }}</p>
    {% else %}
        <p>
            {% if order.payment_label_key %}<strong>{{ trans(order.payment_label_key) }}</strong> – {% endif %}
            {{ trans('core.order.payment_state.' ~ order.payment_state) }}
            {% if order.payment_state == 'paid' and payment.paid_at %}<small>({{ trans('core.payment.paid_at', {date: payment.paid_at}) }})</small>{% endif %}
        </p>
        {% if order.payment_description_key and order.payment_state == 'unpaid' %}
            <p><small>{{ trans(order.payment_description_key) }}</small></p>
        {% endif %}
    {% endif %}

    {% if payment.transfer %}
        <table>
            <tr><th scope="row">{{ trans('core.payment.transfer.holder') }}</th><td>{{ payment.transfer.holder }}</td></tr>
            <tr><th scope="row">{{ trans('core.payment.transfer.iban') }}</th><td>{{ payment.transfer.iban }}</td></tr>
            {% if payment.transfer.bic %}<tr><th scope="row">{{ trans('core.payment.transfer.bic') }}</th><td>{{ payment.transfer.bic }}</td></tr>{% endif %}
            {% if payment.transfer.bank %}<tr><th scope="row">{{ trans('core.payment.transfer.bank') }}</th><td>{{ payment.transfer.bank }}</td></tr>{% endif %}
            <tr><th scope="row">{{ trans('core.order.total') }}</th><td>{{ money(order.total, order.currency) }}</td></tr>
            <tr><th scope="row">{{ trans('core.payment.transfer.reference_label') }}</th><td>{{ payment.transfer.reference }}</td></tr>
        </table>
    {% endif %}

    {% if payment.can_pay_now %}
        {# Answers with a redirect to the payment service; no script of the service runs on this site. #}
        <form method="post" action="{{ url('/orders/' ~ order.id ~ '/pay') }}">
            {{ csrf_field() }}
            <button type="submit">{{ trans('core.payment.pay_now', {amount: money(order.total, order.currency)}) }}</button>
        </form>
    {% endif %}

    {% if payment.choices %}
        <form method="post" action="{{ url('/orders/' ~ order.id ~ '/payment-method') }}" class="stack-form wide">
            {{ csrf_field() }}
            <fieldset>
                <legend>{{ trans(payment.needs_choice ? 'core.payment.choose_legend' : 'core.payment.change_legend') }}</legend>
                {% for method in payment.choices %}
                    <label class="checkbox">
                        <input type="radio" name="payment_method" value="{{ method.id }}" {{ payment.choices|length == 1 ? 'checked' }} required>
                        <span><strong>{{ trans(method.label_key) }}</strong><br><small>{{ trans(method.description_key) }}</small></span>
                    </label>
                {% endfor %}
            </fieldset>
            <button type="submit">{{ trans('core.payment.change_submit') }}</button>
        </form>
    {% endif %}

    {% if can_mark_paid %}
        <form method="post" action="{{ url('/orders/' ~ order.id ~ '/paid') }}">
            {{ csrf_field() }}
            <button type="submit">{{ trans('core.order.mark_paid') }}</button>
        </form>
    {% endif %}

    {% if payment.attempts %}
        <table>
            <caption>{{ trans('core.payment.attempts') }}</caption>
            {% for attempt in payment.attempts %}
                <tr>
                    <th scope="row">{{ attempt.label_key ? trans(attempt.label_key) : attempt.method }}</th>
                    <td>{{ trans('core.payment.attempt.' ~ attempt.status) }}</td>
                    <td><code>{{ attempt.reference }}</code></td>
                    <td>{{ money(attempt.amount, attempt.currency) }}</td>
                    <td><small>{{ attempt.at }} UTC</small></td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}
</section>

<section>
    <h2>{{ trans('core.order.history') }}</h2>
    <ol class="history">
        {% for event in order.events %}
            <li>
                <strong>{{ trans(event.label_key) }}</strong>
                <small>{{ trans('core.order.role.' ~ event.role) }} · {{ event.at }} UTC</small>
                {% if event.note %}<p>{{ event.note|nl2br }}</p>{% endif %}
                {% if event.files %}
                    <ul class="files">
                        {% for file in event.files %}
                            <li><a href="{{ url('/orders/' ~ order.id ~ '/files/' ~ file.id) }}" download>{{ file.name }}</a> <small>({{ (file.size / 1024)|round(0, 'ceil') }} KB)</small></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</section>

<section>
    <h2>{{ trans('core.order.messages') }}</h2>
    {% for message in order.messages %}
        <p class="message {{ message.author_role == role ? 'own' }}">
            <small>{{ message.author_role == 'buyer' ? order.buyer_name : order.provider_name }} · {{ message.created_at }} UTC</small><br>
            {{ message.body|nl2br }}
        </p>
        {% if message.files %}
            <ul class="files">
                {% for file in message.files %}
                    <li><a href="{{ url('/orders/' ~ order.id ~ '/files/' ~ file.id) }}" download>{{ file.name }}</a> <small>({{ (file.size / 1024)|round(0, 'ceil') }} KB)</small></li>
                {% endfor %}
            </ul>
        {% endif %}
    {% else %}
        <p><small>{{ trans('core.order.message.none') }}</small></p>
    {% endfor %}

    <form method="post" action="{{ url('/orders/' ~ order.id ~ '/message') }}" class="stack-form wide" enctype="multipart/form-data">
        {{ csrf_field() }}
        <label for="body">{{ trans('core.order.message.new') }}</label>
        <textarea id="body" name="body" rows="4" maxlength="5000"></textarea>
        <label for="message_files">{{ trans('core.order.file.attach') }}</label>
        <input id="message_files" name="files[]" type="file" multiple>
        <small>{{ trans('core.order.file.hint', file_limits) }}</small>
        <button type="submit">{{ trans('core.order.message.send') }}</button>
    </form>
</section>
{% endblock %}
