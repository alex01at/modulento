{% extends 'layout/base.twig' %}

{# The blocks of the home page in the order an administrator set (Administration → Home page);
   each block is drawn by its partial in home/. While the page is edited in place, every block
   gets its tools from the administration theme (inline/), hidden blocks included. #}
{% block content %}
{% include '@admin/inline/_bar.twig' with {page_path: '/admin/home', add_types: block_types('home')} only %}
{% for block in home_blocks(edit_mode()) %}
    {% if edit_mode() %}
        {% include '@admin/inline/_block.twig' with {block: block, page_path: '/admin/home', partial: block.template, fields: block_fields('home')[block.type] ?? [], label_key: block.label_key, deletable: true, add_types: block_types('home')} %}
    {% elseif block.enabled %}
        {% include block.template with block_context(block) %}
    {% endif %}
{% endfor %}

{# What extensions show on the home page, e.g. the latest posts of a blog. #}
{% for section in home_sections() %}
    {% include section.template with section.data %}
{% endfor %}
{% endblock %}
