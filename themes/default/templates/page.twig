{% extends 'layout/base.twig' %}

{% block title %}{{ page.title }} – {{ site_name }}{% endblock %}

{% block head %}
    {% if page.meta_description %}
        <meta name="description" content="{{ page.meta_description }}">
    {% endif %}
{% endblock %}

{% block content %}
{# The content of a page is the same block layout as the home page (Administration →
   Seiten → ... → page itself, ?edit=1); each block is drawn by its partial in home/ -
   the catalogue is page-agnostic. The title stays its own, page-level field. #}
{% include '@admin/inline/_bar.twig' with {page_path: '/admin/pages/' ~ page.id ~ '/blocks', add_types: block_types('page'), permission: 'core.pages.manage', settings_url: url('/admin/pages/' ~ page.id)} only %}
{% set blocks = page_blocks(page.id, edit_mode('core.pages.manage')) %}
{# A hero block already draws its own <h1>; showing the page's title too would duplicate it. #}
{% set hasHero = blocks|filter(b => b.type == 'hero' and b.enabled)|length > 0 %}
{# page.locale differs from the page's language when this language has no text of its own. #}
{% if not hasHero %}
<article lang="{{ page.locale }}"{% if edit_mode('core.pages.manage') %} class="inline-block" data-block-id="page-{{ page.id }}" data-field-url="{{ url('/admin/pages/' ~ page.id) }}/field" data-csrf="{{ csrf_token() }}"{% endif %}>
    <h1{% if edit_mode('core.pages.manage') %} data-field="title"{% endif %}>{{ page.title }}</h1>
</article>
{% endif %}
{% for block in blocks %}
    {% if edit_mode('core.pages.manage') %}
        {% include '@admin/inline/_block.twig' with {block: block, page_path: '/admin/pages/' ~ page.id ~ '/blocks', partial: block.template, fields: block_fields('page')[block.type] ?? [], label_key: block.label_key, deletable: true, add_types: block_types('page'), permission: 'core.pages.manage'} %}
    {% elseif block.enabled %}
        {% include block.template with block_context(block) %}
    {% endif %}
{% endfor %}
{% endblock %}
