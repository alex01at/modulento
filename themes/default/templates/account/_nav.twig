{# The pages of the logged-in account, shown on top of each of them. #}
<nav class="account-nav" aria-label="{{ trans('core.nav.account') }}">
    <a href="{{ url('/account') }}">{{ trans('core.dashboard.title') }}</a>
    {% if module('inbox') %}
        <a href="{{ url('/account/messages') }}">{{ trans('core.inbox.title') }}</a>
    {% endif %}
    {% if module('notifications') %}
        <a href="{{ url('/account/notifications') }}">{{ trans('core.notification.title') }}</a>
    {% endif %}
    {% if has_catalogue() or provider_status() %}
        <a href="{{ url('/account/orders') }}">{{ trans('core.order.list.buyer') }}</a>
    {% endif %}
    {% if provider_status() %}
        <a href="{{ url('/account/offers') }}">{{ trans('core.offer.mine.title') }}</a>
        <a href="{{ url('/account/sales') }}">{{ trans('core.order.list.provider') }}</a>
        <a href="{{ url('/account/provider') }}">{{ trans('core.provider.title') }}</a>
        <a href="{{ url('/account/payments') }}">{{ trans('core.payment.settings.title') }}</a>
    {% elseif has_catalogue() %}
        <a href="{{ url('/account/provider') }}">{{ trans('core.provider.create') }}</a>
    {% endif %}
    {% if module('requests') %}
        {% if provider_status() %}
            <a href="{{ url('/requests') }}">{{ trans('core.request.open.title') }}</a>
            <a href="{{ url('/account/applications') }}">{{ trans('core.request.applications.mine_title') }}</a>
        {% else %}
            <a href="{{ url('/account/requests') }}">{{ trans('core.request.mine.title') }}</a>
        {% endif %}
    {% endif %}
    {% if module('subscriptions') %}
        <a href="{{ url('/account/subscription') }}">{{ trans('core.account.subscription.nav') }}</a>
    {% endif %}
    {% if module('reviews') %}
        <a href="{{ url('/account/ratings') }}">{{ trans('core.account_rating.nav') }}</a>
    {% endif %}
    {% for link in account_links() %}
        <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
    <a href="{{ url('/account/settings') }}">{{ trans('core.account.settings') }}</a>
</nav>
