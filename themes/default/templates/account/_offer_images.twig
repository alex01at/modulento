{# Included wherever an offer's pictures are managed - the edit form and the wizard's own step. Receives offer (id, images), images_available, max_images, and an optional return URL. #}
{% if offer %}
    <section>
        <h2>{{ trans('core.offer.image.title') }}</h2>
        {% if not images_available %}
            <p>{{ trans('core.offer.image.error.unavailable') }}</p>
        {% else %}
            {% if offer.images %}
                <ul class="card-list">
                    {% for image in offer.images %}
                        <li>
                            <img src="{{ image.thumb }}" alt="{{ trans('core.offer.image.number', {number: loop.index}) }}">
                            <form method="post" action="{{ url('/account/offers/' ~ offer.id ~ '/images/' ~ image.id ~ '/delete') }}">
                                {{ csrf_field() }}
                                {% if return %}<input type="hidden" name="return" value="{{ return }}">{% endif %}
                                <button type="submit" class="link-button">{{ trans('core.offer.image.delete') }}</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if offer.images|length < max_images %}
                <form method="post" action="{{ url('/account/offers/' ~ offer.id ~ '/images') }}" enctype="multipart/form-data" class="stack-form">
                    {{ csrf_field() }}
                    {% if return %}<input type="hidden" name="return" value="{{ return }}">{% endif %}
                    <label for="image">{{ trans('core.offer.image.add') }}</label>
                    <input id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp" required>
                    <small>{{ trans('core.offer.image.hint', {max: max_images}) }}</small>
                    <button type="submit">{{ trans('core.offer.image.upload') }}</button>
                </form>
            {% endif %}
        {% endif %}
    </section>
{% else %}
    <p><small>{{ trans('core.offer.image.after_save') }}</small></p>
{% endif %}
