{% extends 'layout/base.twig' %}

{% block title %}{{ trans('core.account_rating.nav') }} – {{ site_name }}{% endblock %}

{% block content %}
{% include 'account/_nav.twig' %}
<h1>{{ trans('core.account_rating.nav') }}</h1>
<p><small>{{ trans('core.account_rating.origin') }}</small></p>

{% if account_ratings is empty %}
    <p>{{ trans('core.account_rating.none') }}</p>
{% else %}
    {% for rating in account_ratings %}
        <article class="review" lang="{{ rating.locale }}">
            {% if rating.status == 'hidden' %}
                <p class="flash flash-error">{{ trans('core.account_rating.hidden_notice') }}</p>
            {% endif %}
            <p>
                <span role="img" aria-label="{{ trans('core.account_rating.stars', {rating: rating.rating}) }}"><span aria-hidden="true">{% for i in 1..5 %}{{ i <= rating.rating ? '★' : '☆' }}{% endfor %}</span></span>
                <small lang="{{ locale() }}">{{ rating.author ?: trans('core.account_rating.anonymous') }} · {{ rating.created_at|slice(0, 10) }}</small>
            </p>
            {% if rating.body %}<p>{{ rating.body|nl2br }}</p>{% endif %}
            {% if rating.reply %}
                <p class="reply"><small lang="{{ locale() }}">{{ trans('core.account_rating.reply_by_rated') }}</small><br>{{ rating.reply|nl2br }}</p>
            {% elseif rating.id in can_reply_to %}
                <form method="post" action="{{ url('/account-ratings/' ~ rating.id ~ '/reply') }}" class="stack-form wide">
                    {{ csrf_field() }}
                    <input type="hidden" name="return" value="{{ current_path() }}">
                    <label for="rating_reply_{{ rating.id }}">{{ trans('core.account_rating.reply') }}</label>
                    <textarea id="rating_reply_{{ rating.id }}" name="reply" rows="4" maxlength="2000" required></textarea>
                    <small>{{ trans('core.account_rating.reply_hint') }}</small>
                    <button type="submit">{{ trans('core.account_rating.reply_submit') }}</button>
                </form>
            {% endif %}
        </article>
    {% endfor %}

    {% if pages > 1 %}
        <nav class="pager" aria-label="{{ trans('core.pager.label') }}">
            {% if page > 1 %}<a href="{{ url('/account/ratings') }}?page={{ page - 1 }}" rel="prev">{{ trans('core.pager.previous') }}</a>{% endif %}
            <span>{{ trans('core.pager.position', {page: page, pages: pages}) }}</span>
            {% if page < pages %}<a href="{{ url('/account/ratings') }}?page={{ page + 1 }}" rel="next">{{ trans('core.pager.next') }}</a>{% endif %}
        </nav>
    {% endif %}
{% endif %}
<p><a href="{{ url('/account') }}">{{ trans('core.nav.dashboard') }}</a></p>
{% endblock %}
