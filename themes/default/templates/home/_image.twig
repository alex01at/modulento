{# Receives block: media (path of a picture of the media library), texts (caption). #}
{% if block.media or block.background_type %}
<figure data-home-block="{{ block.id }}">
    {% if block.media %}<img src="{{ block.media }}" alt="{{ block.texts.caption }}" loading="lazy">{% endif %}
    {% if block.texts.caption or edit_mode() %}<figcaption data-field="caption">{{ block.texts.caption }}</figcaption>{% endif %}
</figure>
{% endif %}
