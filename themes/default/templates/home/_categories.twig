{# Receives block: texts (heading). The category tree. #}
{% set tree = categories() %}
{% if tree %}
<section>
    <h2 data-field="heading">{{ block.texts.heading }}</h2>
    <ul class="plain-list">
        {% for top in tree %}
            <li><a href="{{ url(top.path) }}">{{ top.name }}</a> <small>({{ top.offer_count }})</small></li>
        {% endfor %}
    </ul>
</section>
{% endif %}
