{% extends 'layout/base.twig' %}

{% block title %}{{ offer.title }} – {{ site_name }}{% endblock %}

{% block meta_description %}{{ offer.summary }}{% endblock %}
{% block meta_image %}{{ offer.images[0].large ?? site_logo('light') }}{% endblock %}

{% block content %}
<article>
    <h1>{{ offer.title }}</h1>
    <p>
        <small>
            <a href="{{ url(offer.provider_path) }}">{{ offer.provider_name }}</a>
            {% if offer.category %}· <a href="{{ url(offer.category.path) }}">{{ offer.category.name }}</a>{% endif %}
            {% if offer.price_from is not null %}· {{ trans('core.offer.price_from', {price: money(offer.price_from, offer.currency)}) }}{% endif %}
        </small>
    </p>

    {% include 'review/_rating.twig' with {rating: offer.rating} only %}

    {# The rest of the page is in the order and of the parts the administration set (Administration → Offer page).
       While it is edited in place, every part gets its tools from the administration theme. #}
    {% include '@admin/inline/_bar.twig' with {page_path: '/admin/offer-page', add_types: ['text']} only %}
    {% for block in offer_blocks(edit_mode()) %}
        {% if edit_mode() %}
            {% include '@admin/inline/_block.twig' with {block: block, page_path: '/admin/offer-page', partial: 'offer/_block_' ~ block.type ~ '.twig', fields: block_fields('offer')[block.type] ?? [], label_key: 'core.offer_page.type.' ~ block.type, deletable: block.type == 'text', add_types: ['text']} %}
        {% elseif block.enabled %}
            {% include 'offer/_block_' ~ block.type ~ '.twig' with {block: block} %}
        {% endif %}
    {% endfor %}
</article>

{# Reporting has to be easy to find where the content is. #}
{% if module('reports') %}
<p><small><a href="{{ url('/report') }}?url={{ url(current_path(), null, true)|url_encode }}" rel="nofollow">{{ trans('core.report.link_here') }}</a></small></p>
{% endif %}
{% endblock %}
