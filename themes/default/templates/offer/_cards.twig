{# A list of offer cards. Receives "offers". #}
<ul class="card-list">
    {% for offer in offers %}
        <li>
            {% if offer.thumb %}
                <a href="{{ url(offer.path) }}" tabindex="-1" aria-hidden="true"><img src="{{ offer.thumb }}" alt="" loading="lazy"></a>
            {% endif %}
            <a href="{{ url(offer.path) }}"><strong>{{ offer.title }}</strong></a>
            {% if offer.summary %}<p>{{ offer.summary }}</p>{% endif %}
            {% include 'review/_rating.twig' with {rating: offer.rating} only %}
            <small>
                <a href="{{ url(offer.provider_path) }}">{{ offer.provider_name }}</a>{% if offer.provider_featured %} <span class="badge badge-earned">{{ trans('core.provider.featured_badge') }}</span>{% endif %}
                {% if offer.price_from is not null %}· {{ trans(offer.price_label_key, {price: money(offer.price_from, offer.currency)}) }}{% endif %}
            </small>
        </li>
    {% endfor %}
</ul>
