{% extends 'layout/base.twig' %}

{% block title %}{{ trans('core.login.title') }} – {{ site_name }}{% endblock %}

{% block content %}
<h1>{{ trans('core.login.title') }}</h1>
<form method="post" action="{{ url('/login') }}" class="stack-form">
    {{ csrf_field() }}
    <label for="email">{{ trans('core.login.email') }}</label>
    <input id="email" name="email" type="email" autocomplete="username" required>

    <label for="password">{{ trans('core.login.password') }}</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>

    <label class="checkbox">
        <input type="checkbox" name="remember" value="1">
        <span>{{ trans('core.login.remember') }}</span>
    </label>

    <button type="submit">{{ trans('core.login.submit') }}</button>
</form>

{% if can_resend_verification %}
    <form method="post" action="{{ url('/verify-email/resend') }}">
        {{ csrf_field() }}
        <button type="submit" class="link-button">{{ trans('core.verify.resend') }}</button>
    </form>
{% endif %}

<p>
    <a href="{{ url('/forgot-password') }}">{{ trans('core.login.forgot') }}</a>
    {% if registration_open() %}
        · <a href="{{ url('/register') }}">{{ trans('core.login.register') }}</a>
    {% endif %}
</p>
{% endblock %}
